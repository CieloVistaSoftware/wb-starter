{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cardexpandable.schema.json",
  "title": "Expandable Card",
  "description": "Card with collapsible/expandable content section",
  "schemaFor": "cardexpandable",
  "baseClass": "x-card-expandable",
  "semanticElement": {
    "tagName": "article",
    "implicitRole": "article"
  },
  "compliance": {
    "baseClass": "x-card-expandable",
    "supportLevel": "stable",
    "accessibility": "high"
  },
  "properties": {
    "title": {
      "type": "string",
      "description": "Card title",
      "required": true,
      "default": ""
    },
    "content": {
      "type": "string",
      "description": "Expandable content",
      "default": ""
    },
    "expanded": {
      "type": "boolean",
      "description": "Initial expanded state",
      "default": false,
      "appliesClass": "x-card-expandable--expanded"
    },
    "maxHeight": {
      "type": "string",
      "description": "Max height when collapsed (pixel/unit string). Ignored when `lines` is set -- use maxHeight for non-text/mixed content where line-clamp doesn't apply.",
      "default": "100px"
    },
    "lines": {
      "type": "number",
      "description": "Clamp collapsed text to exactly N full lines via CSS line-clamp, instead of an arbitrary pixel maxHeight. Takes priority over maxHeight when set.",
      "default": null
    },
    "variant": {
      "type": "string",
      "enum": [
        "default",
        "elevated",
        "bordered"
      ],
      "default": "default",
      "appliesClass": "x-card-expandable--{{value}}"
    }
  },
  "$view": [
    {
      "name": "header",
      "tag": "header",
      "public": true,
      "required": true,
      "description": "Card header"
    },
    {
      "name": "title",
      "tag": "h3",
      "parent": "header",
      "public": true,
      "content": "{{title}}",
      "description": "Card title"
    },
    {
      "name": "content",
      "tag": "main",
      "public": true,
      "required": true,
      "content": "<slot>{{content}}</slot>",
      "description": "Expandable content area"
    },
    {
      "name": "footer",
      "tag": "footer",
      "public": true,
      "required": true,
      "description": "Expand button container"
    },
    {
      "name": "expand-btn",
      "tag": "button",
      "parent": "footer",
      "public": true,
      "description": "Expand/collapse toggle button"
    },
    {
      "name": "expand-icon",
      "tag": "span",
      "parent": "expand-btn",
      "public": false,
      "description": "Toggle icon"
    },
    {
      "name": "expand-text",
      "tag": "span",
      "parent": "expand-btn",
      "public": true,
      "description": "Toggle button text"
    }
  ],
  "$methods": {
    "expand": {
      "description": "Expands the card",
      "params": []
    },
    "collapse": {
      "description": "Collapses the card",
      "params": []
    },
    "toggle": {
      "description": "Toggles expanded state",
      "params": []
    },
    "isExpanded": {
      "description": "Returns expanded state",
      "params": [],
      "returns": "boolean"
    }
  },
  "$cssAPI": {
    "--x-card-expandable-padding": {
      "default": "1rem",
      "description": "Card padding"
    },
    "--x-card-expandable-radius": {
      "default": "8px",
      "description": "Border radius"
    },
    "--x-card-expandable-max-height": {
      "default": "100px",
      "description": "Collapsed max height"
    },
    "--x-card-expandable-transition": {
      "default": "max-height 0.3s ease",
      "description": "Expand transition"
    },
    "--x-card-expandable-btn-color": {
      "default": "var(--primary, #6366f1)",
      "description": "Button color"
    }
  },
  "events": {
    "wb:expandable:toggle": {
      "description": "Fired on expand/collapse",
      "detail": {
        "expanded": "boolean"
      }
    }
  },
  "test": {
    "setup": [
      "<div x-cardexpandable>Basic cardexpandable content</div>",
      "<div x-cardexpandable variant=\"default\">variant=default</div>",
      "<div x-cardexpandable variant=\"elevated\">variant=elevated</div>",
      "<div x-cardexpandable variant=\"bordered\">variant=bordered</div>",
      "<div x-cardexpandable expanded>with expanded</div>",
      "<div x-cardexpandable title=\"Sample title\">title=\"Sample title\"</div>",
      "<div x-cardexpandable content=\"Sample content\">content=\"Sample content\"</div>",
      "<div x-cardexpandable max-height=\"100px\">maxHeight=\"100px\"</div>",
      "<div x-cardexpandable title=\"Details\">Content here</div>"
    ],
    "matrix": {
      "combinations": [
        {
          "title": "Basic",
          "content": "Content"
        },
        {
          "title": "Expanded",
          "content": "Content",
          "expanded": true
        },
        {
          "title": "Custom",
          "content": "Content",
          "maxHeight": "150px"
        }
      ]
    },
    "site": {
      "page": "cards",
      "tag": "x-cardexpandable",
      "renders": true,
      "baseClass": "x-card-expandable",
      "minInstances": 3,
      "checkText": [
        "Basic",
        "Expanded",
        "Custom"
      ],
      "checkClasses": [
        "x-card-expandable--elevated"
      ],
      "checkAttributes": [
        "title",
        "content"
      ]
    }
  },
  "_metadata": {
    "category": "cards",
    "icon": "➕",
    "since": "1.0.0",
    "status": "stable"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sticky.schema.json",
  "title": "Sticky",
  "description": "Makes element stick to viewport on scroll",
  "schemaFor": "sticky",
  "baseClass": "x-sticky",
  "semanticElement": {
    "tagName": "div"
  },
  "compliance": {
    "baseClass": "x-sticky",
    "supportLevel": "stable",
    "accessibility": "high"
  },
  "properties": {
    "offset": {
      "type": "string",
      "description": "Offset from top when stuck",
      "default": "0"
    },
    "zIndex": {
      "type": "number",
      "description": "Z-index when stuck",
      "default": 100
    },
    "threshold": {
      "type": "number",
      "description": "Scroll position to trigger sticky",
      "default": 0
    },
    "stuckClass": {
      "type": "string",
      "description": "Class added when stuck",
      "default": "is-stuck"
    },
    "animated": {
      "type": "boolean",
      "description": "Animate stick/unstick",
      "default": true
    }
  },
  "$view": [
    {
      "name": "placeholder",
      "tag": "div",
      "public": false,
      "description": "Placeholder to prevent layout shift"
    }
  ],
  "$methods": {
    "stick": {
      "description": "Forces sticky state",
      "params": []
    },
    "unstick": {
      "description": "Forces unsticky state",
      "params": []
    },
    "isStuck": {
      "description": "Returns stuck state",
      "params": [],
      "returns": "boolean"
    }
  },
  "$cssAPI": {
    "--x-sticky-offset": {
      "default": "0",
      "description": "Top offset when stuck"
    },
    "--x-sticky-z-index": {
      "default": "100",
      "description": "Z-index when stuck"
    },
    "--x-sticky-transition": {
      "default": "all 0.2s ease",
      "description": "Transition"
    },
    "--x-sticky-shadow": {
      "default": "0 2px 8px rgba(0,0,0,0.1)",
      "description": "Shadow when stuck"
    }
  },
  "events": {
    "wb:sticky:stuck": {
      "description": "Element became stuck",
      "detail": {
        "offset": "number"
      }
    },
    "wb:sticky:unstuck": {
      "description": "Element unstuck"
    }
  },
  "test": {
    "setup": [
      "<div x-sticky>Basic sticky content</div>",
      "<div x-sticky animated>with animated</div>",
      "<div x-sticky offset=\"0\">offset=\"0\"</div>",
      "<div x-sticky z-index=\"100\">zIndex=100</div>",
      "<div x-sticky threshold=\"50\">threshold=50</div>",
      "<div x-sticky stuck-class=\"is-stuck\">stuckClass=\"is-stuck\"</div>",
      "<div x-sticky>Navigation</div>"
    ],
    "matrix": {
      "combinations": [
        {},
        {
          "offset": "60"
        },
        {
          "animated": true
        }
      ]
    },
    "site": {
      "page": "layout",
      "tag": "x-sticky",
      "renders": true,
      "baseClass": "x-sticky",
      "minInstances": 3,
      "checkText": [],
      "checkClasses": [],
      "checkAttributes": []
    }
  },
  "_metadata": {
    "category": "layout",
    "icon": "📌",
    "since": "1.0.0",
    "status": "stable"
  }
}

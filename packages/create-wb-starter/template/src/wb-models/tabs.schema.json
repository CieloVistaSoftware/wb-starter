{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tabs.schema.json",
  "title": "Tabs",
  "description": "Tab navigation for switching between content panels",
  "schemaFor": "tabs",
  "baseClass": "x-tabs",
  "semanticElement": {
    "tagName": "div",
    "implicitRole": "tablist"
  },
  "compliance": {
    "baseClass": "x-tabs",
    "supportLevel": "stable",
    "accessibility": "high"
  },
  "properties": {
    "activeTab": {
      "type": "number",
      "description": "Initially active tab index",
      "default": 0
    },
    "variant": {
      "type": "string",
      "enum": [
        "default",
        "pills",
        "underline",
        "bordered"
      ],
      "default": "default",
      "appliesClass": "x-tabs--{{value}}"
    },
    "size": {
      "type": "string",
      "enum": [
        "sm",
        "md",
        "lg"
      ],
      "default": "md",
      "appliesClass": "x-tabs--{{value}}"
    },
    "fullWidth": {
      "type": "boolean",
      "description": "Tabs fill container width",
      "default": false,
      "appliesClass": "x-tabs--full-width"
    },
    "vertical": {
      "type": "boolean",
      "description": "Vertical tab layout",
      "default": false,
      "appliesClass": "x-tabs--vertical"
    }
  },
  "$view": [],
  "$methods": {
    "setActiveTab": {
      "description": "Activates a tab by index",
      "params": [
        "index"
      ]
    },
    "getActiveTab": {
      "description": "Returns active tab index",
      "params": [],
      "returns": "number"
    },
    "next": {
      "description": "Activates next tab",
      "params": []
    },
    "prev": {
      "description": "Activates previous tab",
      "params": []
    },
    "first": {
      "description": "Activates first tab",
      "params": []
    },
    "last": {
      "description": "Activates last tab",
      "params": []
    }
  },
  "$cssAPI": {
    "--x-tabs-gap": {
      "default": "0",
      "description": "Gap between tabs"
    },
    "--x-tabs-border": {
      "default": "1px solid var(--border-color, #e0e0e0)",
      "description": "Tab list border"
    },
    "--x-tabs-tab-padding": {
      "default": "0.75rem 1rem",
      "description": "Tab padding"
    },
    "--x-tabs-tab-color": {
      "default": "var(--text-secondary, #666)",
      "description": "Tab text color"
    },
    "--x-tabs-tab-bg": {
      "default": "transparent",
      "description": "Tab background"
    },
    "--x-tabs-tab-active-color": {
      "default": "var(--primary, #6366f1)",
      "description": "Active tab color"
    },
    "--x-tabs-tab-active-bg": {
      "default": "transparent",
      "description": "Active tab background"
    },
    "--x-tabs-tab-hover-color": {
      "default": "var(--text-primary, #1a1a1a)",
      "description": "Tab hover color"
    },
    "--x-tabs-indicator-color": {
      "default": "var(--primary, #6366f1)",
      "description": "Active indicator color"
    },
    "--x-tabs-indicator-height": {
      "default": "2px",
      "description": "Active indicator height"
    },
    "--x-tabs-panel-padding": {
      "default": "1rem 0",
      "description": "Panel padding"
    }
  },
  "accessibility": {
    "tablist": {
      "role": "tablist"
    },
    "tab": {
      "role": "tab",
      "ariaSelected": "dynamic",
      "ariaControls": "panel id"
    },
    "panel": {
      "role": "tabpanel",
      "ariaLabelledBy": "tab id"
    }
  },
  "events": {
    "wb:tabs:change": {
      "description": "Tab changed",
      "detail": {
        "index": "number",
        "previousIndex": "number"
      }
    }
  },
  "test": {
    "functional": true,
    "setup": [
      "<div x-tabs>Basic tabs content</div>",
      "<div x-tabs variant=\"default\">variant=default</div>",
      "<div x-tabs variant=\"pills\">variant=pills</div>",
      "<div x-tabs variant=\"underline\">variant=underline</div>",
      "<div x-tabs size=\"sm\">size=sm</div>",
      "<div x-tabs size=\"md\">size=md</div>",
      "<div x-tabs size=\"lg\">size=lg</div>",
      "<div x-tabs full-width>with fullWidth</div>"
    ],
    "matrix": {
      "combinations": [
        {
          "activeTab": 0
        },
        {
          "activeTab": 1
        },
        {
          "variant": "pills"
        },
        {
          "variant": "underline"
        },
        {
          "fullWidth": true
        }
      ]
    },
    "site": {
      "page": "layout",
      "tag": "x-tabs",
      "renders": true,
      "baseClass": "x-tabs",
      "minInstances": 5,
      "checkText": [],
      "checkClasses": [
        "x-tabs--pills",
        "x-tabs--sm"
      ],
      "checkAttributes": []
    }
  },
  "_metadata": {
    "category": "navigation",
    "icon": "📑",
    "since": "1.0.0",
    "status": "stable"
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stepper Behavior",
  "schemaFor": "stepper",
  "schemaType": "behavior",
  "type": "object",
  "description": "x-stepper builds a number field with − and + buttons that change the value by step, never going below min or above max.",
  "properties": {
    "min": {
      "type": "number",
      "description": "Minimum value",
      "default": 0
    },
    "max": {
      "type": "number",
      "description": "Maximum value",
      "default": 0
    },
    "step": {
      "type": "number",
      "description": "Step increment",
      "default": 0
    }
  },
  "required": [],
  "wbBehavior": {
    "name": "stepper",
    "type": "modifier",
    "category": "inputs",
    "description": "Adds increment/decrement controls to numeric inputs.",
    "src": "src/wb-viewmodels/stepper.js"
  },
  "$view": []
}

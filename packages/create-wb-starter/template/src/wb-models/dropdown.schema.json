{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dropdown.schema.json",
  "title": "Dropdown",
  "description": "Toggleable dropdown menu",
  "schemaFor": "dropdown",
  "baseClass": "x-dropdown",
  "semanticElement": {
    "tagName": "div",
    "implicitRole": "menu"
  },
  "compliance": {
    "baseClass": "x-dropdown",
    "supportLevel": "stable",
    "accessibility": "high"
  },
  "properties": {
    "position": {
      "type": "string",
      "enum": [
        "bottom-start",
        "bottom-end",
        "top-start",
        "top-end"
      ],
      "default": "bottom-start",
      "appliesClass": "x-dropdown--{{value}}"
    },
    "trigger": {
      "type": "string",
      "enum": [
        "click",
        "hover"
      ],
      "default": "click"
    },
    "closeOnSelect": {
      "type": "boolean",
      "description": "Close on item select",
      "default": true
    },
    "closeOnOutside": {
      "type": "boolean",
      "description": "Close on outside click",
      "default": true
    },
    "offset": {
      "type": "number",
      "description": "Offset from trigger (px)",
      "default": 4
    }
  },
  "$view": [
    {
      "name": "trigger",
      "tag": "button",
      "public": true,
      "required": true,
      "description": "Dropdown trigger button"
    },
    {
      "name": "menu",
      "tag": "div",
      "public": true,
      "required": true,
      "description": "Dropdown menu container"
    },
    {
      "name": "items",
      "tag": "slot",
      "parent": "menu",
      "public": true,
      "description": "Menu items slot"
    }
  ],
  "$methods": {
    "open": {
      "description": "Opens the dropdown",
      "params": []
    },
    "close": {
      "description": "Closes the dropdown",
      "params": []
    },
    "toggle": {
      "description": "Toggles the dropdown",
      "params": []
    },
    "isOpen": {
      "description": "Returns open state",
      "params": [],
      "returns": "boolean"
    }
  },
  "$cssAPI": {
    "--x-dropdown-min-width": {
      "default": "180px",
      "description": "Menu min width"
    },
    "--x-dropdown-max-height": {
      "default": "300px",
      "description": "Menu max height"
    },
    "--x-dropdown-bg": {
      "default": "var(--bg-surface, #ffffff)",
      "description": "Menu background"
    },
    "--x-dropdown-border": {
      "default": "1px solid var(--border-color, #e0e0e0)",
      "description": "Menu border"
    },
    "--x-dropdown-radius": {
      "default": "4px",
      "description": "Border radius"
    },
    "--x-dropdown-shadow": {
      "default": "0 4px 12px rgba(0,0,0,0.15)",
      "description": "Box shadow"
    },
    "--x-dropdown-padding": {
      "default": "0.25rem",
      "description": "Menu padding"
    },
    "--x-dropdown-item-padding": {
      "default": "0.5rem 0.75rem",
      "description": "Item padding"
    },
    "--x-dropdown-item-hover-bg": {
      "default": "var(--bg-secondary, #f3f4f6)",
      "description": "Item hover background"
    },
    "--x-dropdown-z-index": {
      "default": "100",
      "description": "Z-index"
    }
  },
  "accessibility": {
    "trigger": {
      "ariaHaspopup": "menu",
      "ariaExpanded": "dynamic"
    },
    "menu": {
      "role": "menu"
    },
    "item": {
      "role": "menuitem"
    }
  },
  "events": {
    "wb:dropdown:open": {
      "description": "Dropdown opened"
    },
    "wb:dropdown:close": {
      "description": "Dropdown closed"
    },
    "wb:dropdown:select": {
      "description": "Item selected",
      "detail": {
        "value": "string"
      }
    }
  },
  "test": {
    "functional": true,
    "setup": [
      "<div x-dropdown>Basic dropdown content</div>",
      "<div x-dropdown position=\"bottom-start\">position=bottom-start</div>",
      "<div x-dropdown position=\"bottom-end\">position=bottom-end</div>",
      "<div x-dropdown position=\"top-start\">position=top-start</div>",
      "<div x-dropdown trigger=\"click\">trigger=click</div>",
      "<div x-dropdown trigger=\"hover\">trigger=hover</div>",
      "<div x-dropdown close-on-select>with closeOnSelect</div>",
      "<div x-dropdown close-on-outside>with closeOnOutside</div>"
    ],
    "matrix": {
      "combinations": [
        {
          "position": "bottom-start"
        },
        {
          "position": "bottom-end"
        },
        {
          "trigger": "hover"
        }
      ]
    },
    "site": {
      "page": "overlays",
      "tag": "x-dropdown",
      "renders": true,
      "baseClass": "x-dropdown",
      "minInstances": 3,
      "checkText": [],
      "checkClasses": [
        "x-dropdown--bottom-end"
      ],
      "checkAttributes": [
        "position"
      ]
    }
  },
  "_metadata": {
    "category": "overlay",
    "icon": "📋",
    "since": "1.0.0",
    "status": "stable"
  }
}

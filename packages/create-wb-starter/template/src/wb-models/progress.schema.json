{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "progress.schema.json",
  "title": "Progress",
  "description": "Progress bar with determinate and indeterminate states",
  "schemaFor": "progress",
  "baseClass": "x-progress",
  "semanticElement": {
    "tagName": "progress",
    "implicitRole": "progressbar"
  },
  "compliance": {
    "baseClass": "x-progress",
    "supportLevel": "stable",
    "accessibility": "high"
  },
  "properties": {
    "value": {
      "type": "number",
      "description": "Current progress value (0-100)",
      "default": 0,
      "minimum": 0,
      "maximum": 100
    },
    "max": {
      "type": "number",
      "description": "Maximum value",
      "default": 100
    },
    "label": {
      "type": "string",
      "description": "Progress label text",
      "default": ""
    },
    "showValue": {
      "type": "boolean",
      "description": "Show percentage value",
      "default": false
    },
    "variant": {
      "type": "string",
      "description": "Color variant",
      "enum": [
        "default",
        "primary",
        "success",
        "warning",
        "error",
        "info"
      ],
      "default": "primary",
      "appliesClass": "x-progress--{{value}}"
    },
    "size": {
      "type": "string",
      "description": "Bar height size",
      "enum": [
        "xs",
        "sm",
        "md",
        "lg",
        "xl"
      ],
      "default": "md",
      "appliesClass": "x-progress--{{value}}"
    },
    "animated": {
      "type": "boolean",
      "description": "Animate on load",
      "default": true
    },
    "striped": {
      "type": "boolean",
      "description": "Show striped pattern",
      "default": false,
      "appliesClass": "x-progress--striped"
    },
    "indeterminate": {
      "type": "boolean",
      "description": "Indeterminate loading state",
      "default": false,
      "appliesClass": "x-progress--indeterminate"
    }
  },
  "$view": [],
  "$methods": {
    "getValue": {
      "description": "Gets the current progress value",
      "params": [],
      "returns": "number"
    },
    "setValue": {
      "description": "Sets the progress value",
      "params": [
        "value"
      ]
    },
    "increment": {
      "description": "Increments the progress value",
      "params": [
        "amount"
      ]
    },
    "decrement": {
      "description": "Decrements the progress value",
      "params": [
        "amount"
      ]
    },
    "reset": {
      "description": "Resets progress to 0",
      "params": []
    },
    "complete": {
      "description": "Sets progress to 100%",
      "params": []
    },
    "setIndeterminate": {
      "description": "Sets indeterminate state",
      "params": [
        "isIndeterminate"
      ]
    }
  },
  "$cssAPI": {
    "--x-progress-height": {
      "default": "8px",
      "description": "Progress bar height"
    },
    "--x-progress-radius": {
      "default": "9999px",
      "description": "Border radius"
    },
    "--x-progress-track-bg": {
      "default": "var(--bg-secondary, #e5e7eb)",
      "description": "Track background color"
    },
    "--x-progress-bar-bg": {
      "default": "var(--primary, #6366f1)",
      "description": "Bar background color"
    },
    "--x-progress-transition": {
      "default": "width 0.3s ease",
      "description": "Value change transition"
    },
    "--x-progress-primary-bg": {
      "default": "var(--primary, #6366f1)",
      "description": "Primary variant bar color"
    },
    "--x-progress-success-bg": {
      "default": "var(--success, #22c55e)",
      "description": "Success variant bar color"
    },
    "--x-progress-warning-bg": {
      "default": "var(--warning, #f59e0b)",
      "description": "Warning variant bar color"
    },
    "--x-progress-error-bg": {
      "default": "var(--error, #ef4444)",
      "description": "Error variant bar color"
    },
    "--x-progress-info-bg": {
      "default": "var(--info, #3b82f6)",
      "description": "Info variant bar color"
    },
    "--x-progress-stripe-color": {
      "default": "rgba(255,255,255,0.2)",
      "description": "Stripe overlay color"
    },
    "--x-progress-stripe-width": {
      "default": "1rem",
      "description": "Stripe width"
    },
    "--x-progress-label-size": {
      "default": "0.875rem",
      "description": "Label font size"
    },
    "--x-progress-label-color": {
      "default": "var(--text-primary, #1a1a1a)",
      "description": "Label text color"
    },
    "--x-progress-value-size": {
      "default": "0.875rem",
      "description": "Value text font size"
    },
    "--x-progress-value-color": {
      "default": "var(--text-secondary, #6b7280)",
      "description": "Value text color"
    },
    "--x-progress-gap": {
      "default": "0.5rem",
      "description": "Gap between label and bar"
    }
  },
  "accessibility": {
    "role": "progressbar",
    "ariaValueMin": "0",
    "ariaValueMax": "dynamic from max",
    "ariaValueNow": "dynamic from value",
    "ariaLabel": "dynamic from label or default"
  },
  "test": {
    "functional": true,
    "setup": [
      "<progress value=\"50\" max=\"100\"></progress>",
      "<progress value=\"25\" max=\"100\" variant=\"default\"></progress>",
      "<progress value=\"50\" max=\"100\" variant=\"primary\"></progress>",
      "<progress value=\"75\" max=\"100\" variant=\"success\"></progress>",
      "<progress value=\"30\" max=\"100\" size=\"xs\"></progress>",
      "<progress value=\"40\" max=\"100\" size=\"sm\"></progress>",
      "<progress value=\"60\" max=\"100\" size=\"md\"></progress>",
      "<progress value=\"80\" max=\"100\" show-label></progress>"
    ],
    "matrix": {
      "combinations": [
        {
          "value": 0
        },
        {
          "value": 25
        },
        {
          "value": 50
        },
        {
          "value": 75
        },
        {
          "value": 100
        },
        {
          "value": 50,
          "label": "Loading..."
        },
        {
          "value": 50,
          "showValue": true
        },
        {
          "value": 50,
          "striped": true
        },
        {
          "value": 50,
          "variant": "success"
        },
        {
          "value": 50,
          "variant": "warning"
        },
        {
          "value": 50,
          "variant": "error"
        },
        {
          "value": 50,
          "size": "sm"
        },
        {
          "value": 50,
          "size": "lg"
        },
        {
          "indeterminate": true
        }
      ]
    },
    "site": {
      "page": "feedback",
      "tag": "x-progress",
      "renders": true,
      "baseClass": "x-progress",
      "minInstances": 14,
      "checkText": [],
      "checkClasses": [
        "x-progress--default",
        "x-progress--xs"
      ],
      "checkAttributes": []
    }
  },
  "_metadata": {
    "category": "feedback",
    "icon": "📊",
    "since": "1.0.0",
    "status": "stable"
  }
}

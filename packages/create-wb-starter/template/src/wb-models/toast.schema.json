{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toast.schema.json",
  "title": "Toast",
  "description": "Toast notification system for temporary messages. Container (.x-toast-container, feedback.js's createToast()) is fixed-positioned below the site header rather than the viewport top -- top: calc(var(--site-header-height) + 1rem), so toasts never cover the nav/logo. --site-header-height (site.css) defaults to 0 and is only set to 64px when the page actually has a .site__header, so standalone pages without one are unaffected.",
  "schemaFor": "toast",
  "baseClass": "x-toast",
  "semanticElement": {
    "tagName": "div",
    "implicitRole": "alert"
  },
  "compliance": {
    "baseClass": "x-toast",
    "supportLevel": "stable",
    "accessibility": "high"
  },
  "properties": {
    "message": {
      "type": "string",
      "description": "Toast notification message",
      "required": true,
      "default": ""
    },
    "title": {
      "type": "string",
      "description": "Toast title (optional)",
      "default": ""
    },
    "variant": {
      "type": "string",
      "description": "Toast severity/type",
      "enum": [
        "info",
        "success",
        "warning",
        "error"
      ],
      "default": "info",
      "appliesClass": "x-toast--{{value}}"
    },
    "icon": {
      "type": "string",
      "description": "Icon (emoji or icon name)",
      "default": ""
    },
    "duration": {
      "type": "number",
      "description": "Auto-dismiss duration in milliseconds (0 = no auto-dismiss)",
      "default": 3000,
      "minimum": 0,
      "maximum": 30000
    },
    "position": {
      "type": "string",
      "description": "Toast container position",
      "enum": [
        "top-right",
        "top-left",
        "top-center",
        "bottom-right",
        "bottom-left",
        "bottom-center"
      ],
      "default": "top-right"
    },
    "dismissible": {
      "type": "boolean",
      "description": "Show close button",
      "default": true
    },
    "action": {
      "type": "string",
      "description": "Action button text",
      "default": ""
    },
    "actionHref": {
      "type": "string",
      "description": "Action button link URL",
      "default": ""
    }
  },
  "$view": [
    {
      "name": "container",
      "tag": "div",
      "public": false,
      "required": true,
      "description": "Internal layout container"
    },
    {
      "name": "icon",
      "tag": "span",
      "parent": "container",
      "public": true,
      "content": "{{icon}}",
      "createdWhen": "icon",
      "description": "Toast icon"
    },
    {
      "name": "content",
      "tag": "div",
      "parent": "container",
      "public": true,
      "required": true,
      "description": "Content container"
    },
    {
      "name": "title",
      "tag": "strong",
      "parent": "content",
      "public": true,
      "content": "{{title}}",
      "createdWhen": "title",
      "description": "Toast title"
    },
    {
      "name": "message",
      "tag": "p",
      "parent": "content",
      "public": true,
      "content": "{{message}}",
      "description": "Toast message"
    },
    {
      "name": "actions",
      "tag": "div",
      "parent": "container",
      "public": true,
      "createdWhen": "action OR dismissible",
      "description": "Action buttons container"
    },
    {
      "name": "action",
      "tag": "a",
      "parent": "actions",
      "public": true,
      "content": "{{action}}",
      "createdWhen": "action",
      "description": "Action button"
    },
    {
      "name": "close",
      "tag": "button",
      "parent": "actions",
      "public": true,
      "content": "✕",
      "createdWhen": "dismissible",
      "description": "Close button"
    }
  ],
  "$methods": {
    "show": {
      "description": "Shows a toast notification",
      "params": [
        "message",
        "options"
      ],
      "returns": "Toast instance"
    },
    "hide": {
      "description": "Hides the toast",
      "params": []
    },
    "update": {
      "description": "Updates toast content",
      "params": [
        "message",
        "options"
      ]
    },
    "success": {
      "description": "Shows a success toast",
      "params": [
        "message",
        "options"
      ],
      "returns": "Toast instance"
    },
    "error": {
      "description": "Shows an error toast",
      "params": [
        "message",
        "options"
      ],
      "returns": "Toast instance"
    },
    "warning": {
      "description": "Shows a warning toast",
      "params": [
        "message",
        "options"
      ],
      "returns": "Toast instance"
    },
    "info": {
      "description": "Shows an info toast",
      "params": [
        "message",
        "options"
      ],
      "returns": "Toast instance"
    },
    "dismiss": {
      "description": "Dismisses the toast with animation",
      "params": [],
      "returns": "Promise"
    },
    "dismissAll": {
      "description": "Dismisses all toasts",
      "params": [],
      "static": true
    }
  },
  "$cssAPI": {
    "--x-toast-min-width": {
      "default": "300px",
      "description": "Minimum toast width"
    },
    "--x-toast-max-width": {
      "default": "400px",
      "description": "Maximum toast width"
    },
    "--x-toast-padding": {
      "default": "1rem",
      "description": "Toast padding"
    },
    "--x-toast-radius": {
      "default": "8px",
      "description": "Border radius"
    },
    "--x-toast-shadow": {
      "default": "0 4px 12px rgba(0,0,0,0.15)",
      "description": "Toast shadow"
    },
    "--x-toast-gap": {
      "default": "0.75rem",
      "description": "Gap between icon, content, and actions"
    },
    "--x-toast-stack-gap": {
      "default": "0.5rem",
      "description": "Gap between stacked toasts"
    },
    "--x-toast-z-index": {
      "default": "9999",
      "description": "Toast container z-index"
    },
    "--x-toast-title-size": {
      "default": "0.875rem",
      "description": "Title font size"
    },
    "--x-toast-title-weight": {
      "default": "600",
      "description": "Title font weight"
    },
    "--x-toast-message-size": {
      "default": "0.875rem",
      "description": "Message font size"
    },
    "--x-toast-icon-size": {
      "default": "1.25rem",
      "description": "Icon size"
    },
    "--x-toast-info-bg": {
      "default": "#3b82f6",
      "description": "Info variant background"
    },
    "--x-toast-info-color": {
      "default": "#ffffff",
      "description": "Info variant text color"
    },
    "--x-toast-success-bg": {
      "default": "#22c55e",
      "description": "Success variant background"
    },
    "--x-toast-success-color": {
      "default": "#ffffff",
      "description": "Success variant text color"
    },
    "--x-toast-warning-bg": {
      "default": "#f59e0b",
      "description": "Warning variant background"
    },
    "--x-toast-warning-color": {
      "default": "#ffffff",
      "description": "Warning variant text color"
    },
    "--x-toast-error-bg": {
      "default": "#ef4444",
      "description": "Error variant background"
    },
    "--x-toast-error-color": {
      "default": "#ffffff",
      "description": "Error variant text color"
    },
    "--x-toast-enter-animation": {
      "default": "slideIn 0.3s ease",
      "description": "Enter animation"
    },
    "--x-toast-exit-animation": {
      "default": "slideOut 0.2s ease",
      "description": "Exit animation"
    }
  },
  "accessibility": {
    "role": "alert",
    "ariaLive": "polite"
  },
  "events": {
    "wb:toast:show": {
      "description": "Fired when toast appears",
      "detail": {
        "message": "string",
        "variant": "string"
      }
    },
    "wb:toast:hide": {
      "description": "Fired when toast is dismissed",
      "detail": {}
    },
    "wb:toast:action": {
      "description": "Fired when action button is clicked",
      "detail": {}
    }
  },
  "test": {
    "setup": [
      "<div x-toast>Basic toast content</div>",
      "<div x-toast variant=\"info\">variant=info</div>",
      "<div x-toast variant=\"success\">variant=success</div>",
      "<div x-toast variant=\"warning\">variant=warning</div>",
      "<div x-toast position=\"top-right\">position=top-right</div>",
      "<div x-toast position=\"top-left\">position=top-left</div>",
      "<div x-toast position=\"top-center\">position=top-center</div>",
      "<div x-toast dismissible>with dismissible</div>",
      "<div x-toast title=\"Test Title\">With title attribute</div>"
    ],
    "matrix": {
      "combinations": [
        {
          "message": "Test"
        },
        {
          "message": "Test",
          "variant": "info"
        },
        {
          "message": "Test",
          "variant": "success"
        },
        {
          "message": "Test",
          "variant": "warning"
        },
        {
          "message": "Test",
          "variant": "error"
        },
        {
          "message": "Test",
          "title": "Notice"
        },
        {
          "message": "Test",
          "duration": 5000
        },
        {
          "message": "Test",
          "position": "bottom-right"
        },
        {
          "message": "Test",
          "action": "Undo"
        }
      ]
    },
    "site": {
      "page": "feedback",
      "tag": "x-toast",
      "renders": true,
      "baseClass": "x-toast",
      "minInstances": 9,
      "checkText": [
        "Test"
      ],
      "checkClasses": [
        "x-toast--success"
      ],
      "checkAttributes": [
        "message"
      ]
    }
  },
  "_metadata": {
    "category": "feedback",
    "icon": "🔔",
    "since": "1.0.0",
    "status": "stable"
  }
}

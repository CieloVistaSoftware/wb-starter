{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "search.schema.json",
  "title": "Search",
  "description": "Search input behavior with icon and debounced search events",
  "schemaFor": "search",
  "baseClass": "x-search",
  "semanticElement": {
    "tagName": "div",
    "implicitRole": "search"
  },
  "compliance": {
    "baseClass": "x-search",
    "supportLevel": "stable",
    "accessibility": "high"
  },
  "properties": {
    "placeholder": {
      "type": "string",
      "description": "Placeholder text",
      "default": "Search..."
    },
    "value": {
      "type": "string",
      "description": "Search value",
      "default": ""
    },
    "name": {
      "type": "string",
      "description": "Form field name",
      "default": ""
    },
    "debounce": {
      "type": "number",
      "description": "Debounce delay in milliseconds",
      "default": 300,
      "minimum": 0,
      "maximum": 2000
    },
    "instant": {
      "type": "boolean",
      "description": "Search on every keystroke (no debounce)",
      "default": false
    },
    "disabled": {
      "type": "boolean",
      "description": "Disabled state",
      "default": false
    },
    "size": {
      "type": "string",
      "description": "Search input size",
      "enum": [
        "sm",
        "md",
        "lg"
      ],
      "default": "md",
      "appliesClass": "x-search--{{value}}"
    },
    "variant": {
      "type": "string",
      "description": "Visual variant",
      "enum": [
        "default",
        "glass",
        "minimal"
      ],
      "default": "default",
      "appliesClass": "x-search--{{value}}"
    },
    "icon": {
      "type": "string",
      "description": "Search icon (emoji or icon name)",
      "default": "🔍"
    },
    "clearable": {
      "type": "boolean",
      "description": "Show clear button when has value",
      "default": true
    },
    "loading": {
      "type": "boolean",
      "description": "Show loading state",
      "default": false
    }
  },
  "$view": [
    {
      "name": "wrapper",
      "tag": "div",
      "public": false,
      "required": true,
      "description": "Search wrapper container"
    },
    {
      "name": "icon",
      "tag": "span",
      "parent": "wrapper",
      "public": true,
      "content": "{{icon}}",
      "createdWhen": "icon",
      "description": "Search icon"
    },
    {
      "name": "input",
      "tag": "input",
      "parent": "wrapper",
      "public": true,
      "required": true,
      "description": "Native search input"
    },
    {
      "name": "clear",
      "tag": "button",
      "parent": "wrapper",
      "public": true,
      "content": "✕",
      "createdWhen": "clearable",
      "description": "Clear button"
    },
    {
      "name": "loading",
      "tag": "span",
      "parent": "wrapper",
      "public": true,
      "content": "⏳",
      "createdWhen": "loading",
      "description": "Loading indicator"
    }
  ],
  "$methods": {
    "getValue": {
      "description": "Gets the current search value",
      "params": [],
      "returns": "string"
    },
    "setValue": {
      "description": "Sets the search value",
      "params": [
        "value"
      ]
    },
    "clear": {
      "description": "Clears the search value",
      "params": []
    },
    "focus": {
      "description": "Focuses the search input",
      "params": []
    },
    "blur": {
      "description": "Removes focus from search input",
      "params": []
    },
    "search": {
      "description": "Triggers a search with current value",
      "params": []
    },
    "setLoading": {
      "description": "Sets loading state",
      "params": [
        "loading"
      ]
    }
  },
  "$cssAPI": {
    "--x-search-height": {
      "default": "2.5rem",
      "description": "Search input height"
    },
    "--x-search-padding-x": {
      "default": "0.75rem",
      "description": "Horizontal padding"
    },
    "--x-search-radius": {
      "default": "6px",
      "description": "Border radius"
    },
    "--x-search-font-size": {
      "default": "0.875rem",
      "description": "Font size"
    },
    "--x-search-bg": {
      "default": "var(--bg-surface, #ffffff)",
      "description": "Background color"
    },
    "--x-search-border": {
      "default": "1px solid var(--border-color, #d1d5db)",
      "description": "Border style"
    },
    "--x-search-color": {
      "default": "var(--text-primary, #1a1a1a)",
      "description": "Text color"
    },
    "--x-search-placeholder-color": {
      "default": "var(--text-tertiary, #9ca3af)",
      "description": "Placeholder color"
    },
    "--x-search-focus-border": {
      "default": "var(--primary, #6366f1)",
      "description": "Focus border color"
    },
    "--x-search-focus-ring": {
      "default": "0 0 0 3px rgba(99, 102, 241, 0.2)",
      "description": "Focus ring shadow"
    },
    "--x-search-icon-size": {
      "default": "1rem",
      "description": "Icon size"
    },
    "--x-search-icon-color": {
      "default": "var(--text-secondary, #6b7280)",
      "description": "Icon color"
    },
    "--x-search-clear-size": {
      "default": "0.75rem",
      "description": "Clear button size"
    },
    "--x-search-clear-color": {
      "default": "var(--text-secondary, #6b7280)",
      "description": "Clear button color"
    },
    "--x-search-loading-color": {
      "default": "var(--primary, #6366f1)",
      "description": "Loading indicator color"
    }
  },
  "accessibility": {
    "role": "searchbox",
    "ariaLabel": "Search input",
    "ariaDescribedBy": "search results if applicable"
  },
  "events": {
    "wb:search": {
      "description": "Fired when search is triggered (debounced or instant)",
      "detail": {
        "query": "string",
        "instant": "boolean"
      }
    },
    "wb:search:clear": {
      "description": "Fired when search is cleared",
      "detail": {}
    },
    "input": {
      "description": "Fired on every input change",
      "detail": {
        "value": "string"
      }
    },
    "focus": {
      "description": "Fired when input receives focus",
      "detail": {}
    },
    "blur": {
      "description": "Fired when input loses focus",
      "detail": {}
    }
  },
  "test": {
    "setup": [
      "<div x-searchfield>Basic search</div>",
      "<div x-searchfield placeholder='Search docs...'>Custom placeholder</div>",
      "<div x-searchfield size='lg'>Large search</div>",
      "<div x-searchfield variant='glass'>Glass variant</div>",
      "<div x-searchfield instant>Instant search</div>"
    ],
    "functional": {
      "interactions": [
        {
          "name": "Search Typing",
          "setup": "<div x-searchfield placeholder='Type here'></div>",
          "action": "type",
          "value": "test",
          "expect": {
            "event": "wb:search",
            "detail": {
              "query": "test"
            }
          }
        },
        {
          "name": "Clear Button",
          "setup": "<div x-searchfield value='search term' clearable></div>",
          "steps": [
            {
              "action": "click",
              "selector": "button"
            }
          ],
          "expect": {
            "value": "",
            "event": "wb:search:clear"
          }
        },
        {
          "name": "Instant Search",
          "setup": "<div x-searchfield instant></div>",
          "action": "type",
          "value": "a",
          "expect": {
            "event": "wb:search",
            "detail": {
              "instant": true
            }
          }
        }
      ],
      "visual": [
        {
          "name": "Loading State",
          "setup": "<div x-searchfield loading></div>",
          "expect": {
            "textContains": "⏳"
          }
        },
        {
          "name": "Icon Display",
          "setup": "<div x-searchfield icon='🔎'></div>",
          "expect": {
            "textContains": "🔎"
          }
        }
      ],
      "disabled": [
        {
          "name": "Disabled Search",
          "setup": "<div x-searchfield disabled></div>",
          "action": "click",
          "expect": {
            "attribute": {
              "disabled": ""
            }
          }
        }
      ],
      "focus": [
        {
          "name": "Focus Search",
          "setup": "<div x-searchfield></div>",
          "action": "click",
          "expect": {
            "focused": "input"
          }
        }
      ]
    },
    "matrix": {
      "combinations": [
        {
          "placeholder": "Search..."
        },
        {
          "placeholder": "Search docs...",
          "size": "lg"
        },
        {
          "placeholder": "Glass search",
          "variant": "glass"
        },
        {
          "placeholder": "Minimal",
          "variant": "minimal"
        },
        {
          "placeholder": "Instant search",
          "instant": true
        },
        {
          "placeholder": "Loading...",
          "loading": true
        }
      ]
    },
    "site": {
      "page": "forms",
      "tag": "x-search",
      "renders": true,
      "baseClass": "x-search",
      "minInstances": 6,
      "checkText": [
        "Search...",
        "Search docs...",
        "Glass search",
        "Minimal"
      ],
      "checkClasses": [
        "x-search--sm",
        "x-search--glass"
      ],
      "checkAttributes": [
        "placeholder"
      ]
    }
  },
  "_metadata": {
    "category": "forms",
    "icon": "🔍",
    "since": "3.0.0",
    "status": "stable"
  }
}

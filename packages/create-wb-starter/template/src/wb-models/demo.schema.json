{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "demo.schema.json",
  "title": "Demo Container",
  "description": "A container that renders children normally in a CSS grid and shows the raw HTML as a syntax-highlighted, auto-formatted code sample below. Uses fetch for raw page source, formatHtml for consistent 2-space indentation, and textContent to prevent browser inflation.",
  "schemaFor": "demo",
  "baseClass": "x-demo",
  "semanticElement": {
    "tagName": "div",
    "implicitRole": "region"
  },
  "compliance": {
    "baseClass": "x-demo",
    "supportLevel": "stable",
    "accessibility": "high"
  },
  "properties": {
    "columns": {
      "type": "integer",
      "description": "Number of grid columns for children (1-6)",
      "default": 1,
      "minimum": 1,
      "maximum": 6
    }
  },
  "$cssAPI": {
    "--border-color": {
      "description": "Border color for code sample",
      "default": "inherit"
    }
  },
  "$view": [],
  "$methods": {},
  "test": {
    "setup": [
      "<div x-demo><p>Simple content</p></div>",
      "<div x-demo columns=\"2\"><p>A</p><p>B</p></div>",
      "<div x-demo columns=\"3\"><article title=\"One\"><p>Card 1</p></article><article title=\"Two\"><p>Card 2</p></article><article title=\"Three\"><p>Card 3</p></article></div>"
    ]
  }
}

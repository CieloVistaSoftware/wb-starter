{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stagelight.schema.json",
  "title": "Stage Light",
  "description": "Versatile stage lighting effects including spotlights, beams, and fixtures.",
  "schemaFor": "stagelight",
  "compliance": {
    "baseClass": "x-stagelight",
    "supportLevel": "experimental",
    "accessibility": "presentation"
  },
  "baseClass": "x-stagelight",
  "semanticElement": {
    "tagName": "div",
    "implicitRole": "presentation"
  },
  "properties": {
    "variant": {
      "type": "string",
      "description": "Type of light effect",
      "enum": [
        "beam",
        "spotlight",
        "fixture"
      ],
      "default": "beam",
      "appliesClass": "x-stagelight--{{value}}"
    },
    "color": {
      "type": "string",
      "description": "Color of the light (hex, rgb, or named)",
      "default": "#ffffff"
    },
    "intensity": {
      "type": "number",
      "description": "Brightness/Opacity (0-1)",
      "default": 0.5
    },
    "size": {
      "type": "string",
      "description": "Size of the light/beam",
      "default": "300px"
    },
    "speed": {
      "type": "string",
      "description": "Animation speed (e.g., 3s)",
      "default": "3s"
    },
    "target": {
      "type": "string",
      "description": "Selector for element to track (for spotlight/fixture)",
      "default": "mouse"
    },
    "label": {
      "type": "string",
      "description": "Label for the fixture variant",
      "default": ""
    }
  },
  "$view": [
    {
      "name": "source",
      "tag": "div",
      "class": "x-stagelight__source",
      "createdWhen": "variant == 'fixture' OR variant == 'beam'"
    },
    {
      "name": "beam",
      "tag": "div",
      "class": "x-stagelight__beam",
      "createdWhen": "variant == 'beam'"
    },
    {
      "name": "spot",
      "tag": "div",
      "class": "x-stagelight__spot",
      "createdWhen": "variant == 'spotlight'"
    },
    {
      "name": "housing",
      "tag": "div",
      "class": "x-stagelight__housing",
      "createdWhen": "variant == 'fixture'"
    },
    {
      "name": "label",
      "tag": "span",
      "content": "{{label}}",
      "createdWhen": "variant == 'fixture' AND label"
    }
  ],
  "$methods": {},
  "$cssAPI": {
    "--x-stagelight-color": {
      "description": "Main color of the light",
      "default": "inherit"
    },
    "--x-stagelight-size": {
      "description": "Size of the light beam or spot",
      "default": "inherit"
    },
    "--x-stagelight-intensity": {
      "description": "Opacity of the light",
      "default": "inherit"
    }
  },
  "test": {
    "setup": [
      "<div x-stagelight>Basic stagelight content</div>",
      "<div x-stagelight variant=\"beam\">variant=beam</div>",
      "<div x-stagelight variant=\"spotlight\">variant=spotlight</div>",
      "<div x-stagelight variant=\"fixture\">variant=fixture</div>",
      "<div x-stagelight color=\"#ffffff\">color=\"#ffffff\"</div>",
      "<div x-stagelight intensity=\"0.5\">intensity=0.5</div>",
      "<div x-stagelight size=\"300px\">size=\"300px\"</div>",
      "<div x-stagelight speed=\"3s\">speed=\"3s\"</div>"
    ],
    "matrix": {
      "combinations": [
        {
          "variant": "beam",
          "color": "#6366f1",
          "intensity": 0.7
        },
        {
          "variant": "spotlight",
          "color": "#f59e0b",
          "intensity": 0.5,
          "size": "400px"
        },
        {
          "variant": "fixture",
          "color": "#ef4444",
          "label": "Red Light"
        },
        {
          "variant": "beam",
          "color": "#22c55e",
          "speed": "5s"
        }
      ]
    },
    "site": {
      "page": "effects",
      "tag": "x-stagelight",
      "renders": true,
      "baseClass": "x-stagelight",
      "minInstances": 4,
      "checkText": [
        "Red Light"
      ],
      "checkClasses": [
        "x-stagelight--spotlight"
      ],
      "checkAttributes": [
        "variant",
        "color"
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "table.schema.json",
  "title": "Table",
  "description": "Data table with sorting, filtering, and pagination",
  "schemaFor": "table",
  "baseClass": "x-table",
  "semanticElement": {
    "tagName": "table",
    "implicitRole": "table"
  },
  "compliance": {
    "baseClass": "x-table",
    "supportLevel": "stable",
    "accessibility": "high"
  },
  "properties": {
    "data": {
      "type": "string",
      "description": "Table data as JSON array",
      "default": ""
    },
    "columns": {
      "type": "string",
      "description": "Column config as JSON [{key, label, sortable}]",
      "default": ""
    },
    "sortable": {
      "type": "boolean",
      "description": "Enable column sorting",
      "default": true
    },
    "filterable": {
      "type": "boolean",
      "description": "Enable filtering",
      "default": false
    },
    "paginated": {
      "type": "boolean",
      "description": "Enable pagination",
      "default": false
    },
    "pageSize": {
      "type": "number",
      "description": "Rows per page",
      "default": 10
    },
    "striped": {
      "type": "boolean",
      "description": "Striped rows",
      "default": false,
      "appliesClass": "x-table--striped"
    },
    "hoverable": {
      "type": "boolean",
      "description": "Hover effect on rows",
      "default": true,
      "appliesClass": "x-table--hoverable"
    },
    "compact": {
      "type": "boolean",
      "description": "Compact row spacing",
      "default": false,
      "appliesClass": "x-table--compact"
    },
    "bordered": {
      "type": "boolean",
      "description": "Cell borders",
      "default": false,
      "appliesClass": "x-table--bordered"
    },
    "headers": {
      "type": "string",
      "default": "",
      "description": "Comma-separated column headings."
    },
    "rows": {
      "type": "string",
      "default": "",
      "description": "JSON array-of-arrays of row data."
    },
    "searchable": {
      "type": "boolean",
      "default": false,
      "description": "Show a filter input above the table. Alias of filterable."
    },
    "copyable": {
      "type": "boolean",
      "default": false,
      "description": "Add a control that copies the table as text."
    },
    "selectable": {
      "type": "boolean",
      "default": false,
      "description": "Let a row be clicked to become the active row."
    }
  },
  "$view": [
    {
      "name": "filter",
      "tag": "input",
      "public": true,
      "createdWhen": "filterable",
      "description": "Filter input"
    },
    {
      "name": "thead",
      "tag": "thead",
      "public": true,
      "required": true,
      "description": "Table header"
    },
    {
      "name": "tbody",
      "tag": "tbody",
      "public": true,
      "required": true,
      "description": "Table body"
    },
    {
      "name": "pagination",
      "tag": "nav",
      "public": true,
      "createdWhen": "paginated",
      "description": "Pagination controls"
    }
  ],
  "$methods": {
    "setData": {
      "description": "Sets table data",
      "params": [
        "data"
      ]
    },
    "getData": {
      "description": "Gets current data",
      "params": [],
      "returns": "array"
    },
    "sort": {
      "description": "Sorts by column",
      "params": [
        "column",
        "direction"
      ]
    },
    "filter": {
      "description": "Filters data",
      "params": [
        "query"
      ]
    },
    "goToPage": {
      "description": "Goes to page",
      "params": [
        "page"
      ]
    },
    "refresh": {
      "description": "Refreshes table",
      "params": []
    }
  },
  "$cssAPI": {
    "--x-table-border": {
      "default": "1px solid var(--border-color, #e0e0e0)",
      "description": "Table border"
    },
    "--x-table-radius": {
      "default": "4px",
      "description": "Border radius"
    },
    "--x-table-header-bg": {
      "default": "var(--bg-secondary, #f3f4f6)",
      "description": "Header background"
    },
    "--x-table-header-color": {
      "default": "var(--text-primary, #1a1a1a)",
      "description": "Header text color"
    },
    "--x-table-row-bg": {
      "default": "var(--bg-surface, #ffffff)",
      "description": "Row background"
    },
    "--x-table-row-hover-bg": {
      "default": "var(--bg-secondary, #f3f4f6)",
      "description": "Row hover background"
    },
    "--x-table-row-stripe-bg": {
      "default": "var(--bg-tertiary, #f9fafb)",
      "description": "Striped row background"
    },
    "--x-table-cell-padding": {
      "default": "0.75rem 1rem",
      "description": "Cell padding"
    }
  },
  "accessibility": {
    "role": "table",
    "headers": "scope=\"col\" on th elements"
  },
  "events": {
    "wb:table:sort": {
      "description": "Column sorted",
      "detail": {
        "column": "string",
        "direction": "asc|desc"
      }
    },
    "wb:table:filter": {
      "description": "Data filtered",
      "detail": {
        "query": "string"
      }
    },
    "wb:table:page": {
      "description": "Page changed",
      "detail": {
        "page": "number"
      }
    }
  },
  "test": {
    "setup": [
      "<table>Basic table content</table>",
      "<table sortable>with sortable</table>",
      "<table filterable>with filterable</table>",
      "<table paginated>with paginated</table>",
      "<table striped>with striped</table>",
      "<table hoverable>with hoverable</table>",
      "<table compact>with compact</table>",
      "<table bordered>with bordered</table>"
    ],
    "matrix": {
      "combinations": [
        {},
        {
          "sortable": true
        },
        {
          "striped": true
        },
        {
          "paginated": true,
          "pageSize": 5
        }
      ]
    },
    "site": {
      "page": "content",
      "tag": "x-table",
      "renders": true,
      "baseClass": "x-table",
      "minInstances": 4,
      "checkText": [],
      "checkClasses": [],
      "checkAttributes": []
    }
  },
  "_metadata": {
    "category": "data",
    "icon": "\ud83d\udcca",
    "since": "1.0.0",
    "status": "stable"
  }
}

{
  "$extends": "x-page-defaults",
  "title": "🧩 Multi-Behavior Demo",
  "schemaFor": "multi-behavior-demo",
  "header": {
    "tag": "h1",
    "content": "🧩 Multi-Behavior Demo",
    "subtitle": {
      "tag": "p",
      "content": "Composed from multiple sources using $extends, $generate, $ref, and $include"
    }
  },
  "sections": [
    {
      "$generate": {
        "behavior": "badge",
        "source": "matrix",
        "baseAttrs": { "label": "Badge" },
        "limit": 8
      },
      "heading": "Badges — From Matrix",
      "columns": 4
    },
    {
      "$generate": {
        "behavior": "cardnotification",
        "source": "matrix",
        "baseAttrs": { "message": "Notification message" }
      },
      "heading": "Notifications — Matrix Combos"
    },
    {
      "$generate": {
        "behavior": "progress",
        "source": "enums"
      },
      "heading": "Progress — All Enum Variants"
    },
    {
      "$include": "cardportfolio-showcase"
    },
    {
      "heading": "Custom Hand-Authored Section",
      "tag": "x-badge",
      "columns": 2,
      "demos": [
        { "tag": "x-badge", "attrs": { "label": "Hand-crafted", "variant": "primary", "pill": true } },
        { "tag": "x-badge", "attrs": { "label": "Also custom", "variant": "success", "size": "lg" } }
      ]
    }
  ]
}

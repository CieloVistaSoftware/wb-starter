{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drawer.schema.json",
  "title": "Drawer",
  "description": "Slide-out panel overlay from screen edge",
  "schemaFor": "drawer",
  "baseClass": "x-drawer",
  "semanticElement": {
    "tagName": "aside",
    "implicitRole": "complementary"
  },
  "compliance": {
    "baseClass": "x-drawer",
    "supportLevel": "stable",
    "accessibility": "high"
  },
  "properties": {
    "title": {
      "type": "string",
      "description": "Drawer title",
      "default": ""
    },
    "content": {
      "type": "string",
      "description": "Drawer body content",
      "default": ""
    },
    "position": {
      "type": "string",
      "enum": [
        "left",
        "right",
        "top",
        "bottom"
      ],
      "default": "right",
      "appliesClass": "x-drawer--{{value}}"
    },
    "width": {
      "type": "string",
      "description": "Drawer width (left/right)",
      "default": "320px"
    },
    "height": {
      "type": "string",
      "description": "Drawer height (top/bottom)",
      "default": "auto"
    },
    "closeOnBackdrop": {
      "type": "boolean",
      "description": "Close on backdrop click",
      "default": true
    },
    "closeOnEscape": {
      "type": "boolean",
      "description": "Close on Escape key",
      "default": true
    },
    "showClose": {
      "type": "boolean",
      "description": "Show close button",
      "default": true
    },
    "variant": {
      "type": "string",
      "enum": [
        "default",
        "overlay",
        "push"
      ],
      "default": "overlay",
      "appliesClass": "x-drawer--{{value}}"
    }
  },
  "$view": [
    {
      "name": "backdrop",
      "tag": "div",
      "public": false,
      "description": "Backdrop overlay"
    },
    {
      "name": "panel",
      "tag": "div",
      "public": true,
      "required": true,
      "description": "Drawer panel"
    },
    {
      "name": "header",
      "tag": "header",
      "parent": "panel",
      "public": true,
      "createdWhen": "title OR showClose",
      "description": "Drawer header"
    },
    {
      "name": "title",
      "tag": "h2",
      "parent": "header",
      "public": true,
      "content": "{{title}}",
      "createdWhen": "title",
      "description": "Drawer title"
    },
    {
      "name": "close",
      "tag": "button",
      "parent": "header",
      "public": true,
      "createdWhen": "showClose",
      "description": "Close button"
    },
    {
      "name": "body",
      "tag": "main",
      "parent": "panel",
      "public": true,
      "required": true,
      "content": "<slot>{{content}}</slot>",
      "description": "Drawer body"
    },
    {
      "name": "footer",
      "tag": "footer",
      "parent": "panel",
      "public": true,
      "createdWhen": "footer",
      "description": "Drawer footer"
    }
  ],
  "$methods": {
    "open": {
      "description": "Opens the drawer",
      "params": [],
      "returns": "Promise"
    },
    "close": {
      "description": "Closes the drawer",
      "params": [],
      "returns": "Promise"
    },
    "toggle": {
      "description": "Toggles the drawer",
      "params": []
    },
    "isOpen": {
      "description": "Returns open state",
      "params": [],
      "returns": "boolean"
    }
  },
  "$cssAPI": {
    "--x-drawer-width": {
      "default": "320px",
      "description": "Drawer width"
    },
    "--x-drawer-max-width": {
      "default": "100vw",
      "description": "Max width"
    },
    "--x-drawer-bg": {
      "default": "var(--bg-surface, #ffffff)",
      "description": "Background"
    },
    "--x-drawer-shadow": {
      "default": "-4px 0 20px rgba(0,0,0,0.15)",
      "description": "Box shadow"
    },
    "--x-drawer-padding": {
      "default": "1.5rem",
      "description": "Content padding"
    },
    "--x-drawer-header-gap": {
      "default": "1rem",
      "description": "Header gap"
    },
    "--x-drawer-title-size": {
      "default": "1.125rem",
      "description": "Title font size"
    },
    "--x-drawer-backdrop-bg": {
      "default": "rgba(0,0,0,0.5)",
      "description": "Backdrop background"
    },
    "--x-drawer-transition": {
      "default": "transform 0.3s ease",
      "description": "Slide transition"
    },
    "--x-drawer-z-index": {
      "default": "1000",
      "description": "Z-index"
    }
  },
  "events": {
    "wb:drawer:open": {
      "description": "Drawer opened"
    },
    "wb:drawer:close": {
      "description": "Drawer closed"
    }
  },
  "test": {
    "functional": true,
    "setup": [
      "<div x-drawer>Basic drawer content</div>",
      "<div x-drawer position=\"left\">position=left</div>",
      "<div x-drawer position=\"right\">position=right</div>",
      "<div x-drawer position=\"top\">position=top</div>",
      "<div x-drawer variant=\"default\">variant=default</div>",
      "<div x-drawer variant=\"overlay\">variant=overlay</div>",
      "<div x-drawer variant=\"push\">variant=push</div>",
      "<div x-drawer close-on-backdrop>with closeOnBackdrop</div>",
      "<div x-drawer title=\"Test Title\">With title attribute</div>"
    ],
    "matrix": {
      "combinations": [
        {
          "title": "Right Drawer",
          "position": "right"
        },
        {
          "title": "Left Drawer",
          "position": "left"
        },
        {
          "title": "Wide",
          "width": "400px"
        }
      ]
    },
    "site": {
      "page": "overlays",
      "tag": "x-drawer",
      "renders": true,
      "baseClass": "x-drawer",
      "minInstances": 3,
      "checkText": [
        "Right Drawer",
        "Left Drawer",
        "Wide"
      ],
      "checkClasses": [
        "x-drawer--left",
        "x-drawer--default"
      ],
      "checkAttributes": [
        "title",
        "position"
      ]
    }
  },
  "_metadata": {
    "category": "overlay",
    "icon": "📜",
    "since": "1.0.0",
    "status": "stable"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scrollalong.schema.json",
  "title": "ScrollAlong",
  "description": "CSS sticky positioning for sidebars that stay visible while scrolling",
  "schemaFor": "scrollalong",
  "baseClass": "x-scrollalong",
  "semanticElement": {
    "tagName": "aside"
  },
  "compliance": {
    "baseClass": "x-scrollalong",
    "supportLevel": "stable",
    "accessibility": "high"
  },
  "properties": {
    "offset": {
      "type": "string",
      "description": "Top offset",
      "default": "0"
    }
  },
  "$view": [],
  "$methods": {},
  "$cssAPI": {
    "--x-scrollalong-top": {
      "default": "0",
      "description": "Sticky top position"
    }
  },
  "test": {
    "setup": [
      "<div x-scrollalong>Basic scrollalong content</div>",
      "<div x-scrollalong offset=\"0\">offset=\"0\"</div>",
      "<div x-scrollalong>Test permutation 3</div>",
      "<div x-scrollalong>Test permutation 4</div>",
      "<div x-scrollalong>Test permutation 5</div>",
      "<div x-scrollalong>Sidebar</div>"
    ],
    "matrix": {
      "combinations": [
        {}
      ]
    },
    "site": {
      "page": "layout",
      "tag": "x-scrollalong",
      "renders": true,
      "baseClass": "x-scrollalong",
      "minInstances": 1,
      "checkText": [],
      "checkClasses": [],
      "checkAttributes": []
    }
  },
  "_metadata": {
    "category": "layout",
    "icon": "📜",
    "since": "1.0.0",
    "status": "stable"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cardfile.schema.json",
  "title": "File Card",
  "description": "File display card with icon, name, size, and download",
  "schemaFor": "cardfile",
  "baseClass": "x-cardfile",
  "semanticElement": {
    "tagName": "article",
    "implicitRole": "article"
  },
  "compliance": {
    "baseClass": "x-cardfile",
    "supportLevel": "stable",
    "accessibility": "high"
  },
  "properties": {
    "filename": {
      "type": "string",
      "description": "File name. Its extension picks the icon (#1117, #1119) -- `architecture-diagram.png` renders the image icon. There is no fileType attribute: the filename is the only way to say what kind of file it is.",
      "required": true,
      "default": "this is the filename",
      "examples": [
        "quarterly-report.pdf",
        "meeting-notes.docx",
        "architecture-diagram.png",
        "product-walkthrough.mp4",
        "interview-recording.m4a",
        "release-assets.zip",
        "sensor-capture.bin"
      ]
    },
    "size": {
      "type": "string",
      "description": "File size (e.g., 2.4 MB)",
      "default": "this is the size"
    },
    "date": {
      "type": "string",
      "description": "File date",
      "default": "this is the date"
    },
    "href": {
      "type": "string",
      "description": "Download URL",
      "default": "#"
    },
    "downloadable": {
      "type": "boolean",
      "description": "Show download link",
      "default": true
    },
    "variant": {
      "type": "string",
      "enum": [
        "default",
        "compact",
        "elevated"
      ],
      "default": "default"
    },
    "hoverText": {
      "type": "string",
      "description": "Alias for `tooltip` -- hover text shown as a themed WB tooltip (x-tooltip / tooltip.js), not the native browser title tooltip (#283).",
      "default": "this is the hover text",
      "appliesAttribute": "x-tooltip"
    }
  },
  "$view": [
    {
      "name": "icon",
      "tag": "div",
      "public": true,
      "required": true,
      "description": "File type icon"
    },
    {
      "name": "info",
      "tag": "div",
      "public": true,
      "required": true,
      "description": "File info container"
    },
    {
      "name": "filename",
      "tag": "span",
      "parent": "info",
      "public": true,
      "content": "{{filename}}",
      "description": "File name"
    },
    {
      "name": "meta",
      "tag": "span",
      "parent": "info",
      "public": true,
      "createdWhen": "size OR date",
      "description": "File metadata"
    },
    {
      "name": "download",
      "tag": "a",
      "public": true,
      "createdWhen": "downloadable AND href",
      "description": "Download link"
    }
  ],
  "$methods": {
    "show": {
      "description": "Shows the card",
      "params": []
    },
    "hide": {
      "description": "Hides the card",
      "params": []
    },
    "download": {
      "description": "Triggers download",
      "params": []
    }
  },
  "$cssAPI": {
    "--x-card-file-padding": {
      "default": "1rem",
      "description": "Card padding"
    },
    "--x-card-file-radius": {
      "default": "8px",
      "description": "Border radius"
    },
    "--x-card-file-gap": {
      "default": "1rem",
      "description": "Gap between elements"
    },
    "--x-card-file-icon-size": {
      "default": "40px",
      "description": "Icon size"
    },
    "--x-card-file-icon-bg": {
      "default": "var(--bg-secondary, #f3f4f6)",
      "description": "Icon background"
    },
    "--x-card-file-name-size": {
      "default": "0.875rem",
      "description": "Filename font size"
    },
    "--x-card-file-name-weight": {
      "default": "600",
      "description": "Filename font weight"
    },
    "--x-card-file-meta-size": {
      "default": "0.75rem",
      "description": "Meta font size"
    },
    "--x-card-file-meta-color": {
      "default": "var(--text-secondary, #666)",
      "description": "Meta text color"
    }
  },
  "test": {
    "setup": [
      "<div x-cardfile>Basic cardfile content</div>",
      "<div x-cardfile filename=\"quarterly-report.pdf\">filename=quarterly-report.pdf</div>",
      "<div x-cardfile filename=\"meeting-notes.docx\">filename=meeting-notes.docx</div>",
      "<div x-cardfile filename=\"architecture-diagram.png\">filename=architecture-diagram.png</div>",
      "<div x-cardfile filename=\"product-walkthrough.mp4\">filename=product-walkthrough.mp4</div>",
      "<div x-cardfile filename=\"interview-recording.m4a\">filename=interview-recording.m4a</div>",
      "<div x-cardfile filename=\"release-assets.zip\">filename=release-assets.zip</div>",
      "<div x-cardfile filename=\"sensor-capture.bin\">filename=sensor-capture.bin</div>",
      "<div x-cardfile filename=\"quarterly-report.pdf\" variant=\"default\">variant=default</div>",
      "<div x-cardfile filename=\"quarterly-report.pdf\" variant=\"compact\">variant=compact</div>",
      "<div x-cardfile filename=\"quarterly-report.pdf\" variant=\"elevated\">variant=elevated</div>",
      "<div x-cardfile filename=\"quarterly-report.pdf\" href=\"#\" downloadable>with downloadable</div>",
      "<div x-cardfile filename=\"quarterly-report.pdf\"></div>"
    ],
    "matrix": {
      "combinations": [
        {
          "filename": "quarterly-report.pdf"
        },
        {
          "filename": "meeting-notes.docx",
          "size": "480 KB"
        },
        {
          "filename": "architecture-diagram.png",
          "size": "2.4 MB"
        },
        {
          "filename": "product-walkthrough.mp4",
          "size": "58 MB"
        },
        {
          "filename": "interview-recording.m4a",
          "size": "12 MB"
        },
        {
          "filename": "release-assets.zip",
          "size": "104 MB"
        },
        {
          "filename": "sensor-capture.bin",
          "size": "31 MB"
        }
      ]
    },
    "site": {
      "page": "cards",
      "tag": "x-cardfile",
      "renders": true,
      "minInstances": 3,
      "checkText": [],
      "checkClasses": [
        "x-cardfile--compact"
      ],
      "checkAttributes": [
        "filename"
      ]
    }
  },
  "_metadata": {
    "category": "cards",
    "icon": "📄",
    "since": "1.0.0",
    "status": "stable"
  }
}

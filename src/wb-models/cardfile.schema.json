{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cardfile.schema.json",
  "title": "File Card",
  "description": "File display card with icon, name, size, and download",
  "schemaFor": "cardfile",
  "baseClass": "x-card-file",
  "semanticElement": {
    "tagName": "article",
    "implicitRole": "article"
  },
  "compliance": {
    "baseClass": "x-card-file",
    "supportLevel": "stable",
    "accessibility": "high"
  },
  "properties": {
    "filename": {
      "type": "string",
      "description": "File name",
      "required": true,
      "default": ""
    },
    "fileType": {
      "type": "string",
      "description": "File type for icon",
      "enum": [
        "pdf",
        "doc",
        "image",
        "video",
        "audio",
        "zip",
        "file"
      ],
      "default": "file"
    },
    "size": {
      "type": "string",
      "description": "File size (e.g., 2.4 MB)",
      "default": ""
    },
    "date": {
      "type": "string",
      "description": "File date",
      "default": ""
    },
    "href": {
      "type": "string",
      "description": "Download URL",
      "default": ""
    },
    "downloadable": {
      "type": "boolean",
      "description": "Show download link",
      "default": true
    },
    "variant": {
      "type": "string",
      "enum": [
        "default",
        "compact",
        "elevated"
      ],
      "default": "default",
      "appliesClass": "x-card-file--{{value}}"
    },
    "hoverText": {
      "type": "string",
      "description": "Alias for `tooltip` -- hover text shown as a themed WB tooltip (x-tooltip / tooltip.js), not the native browser title tooltip (#283).",
      "default": "",
      "appliesAttribute": "x-tooltip"
    }
  },
  "$view": [
    {
      "name": "icon",
      "tag": "div",
      "public": true,
      "required": true,
      "description": "File type icon"
    },
    {
      "name": "info",
      "tag": "div",
      "public": true,
      "required": true,
      "description": "File info container"
    },
    {
      "name": "filename",
      "tag": "span",
      "parent": "info",
      "public": true,
      "content": "{{filename}}",
      "description": "File name"
    },
    {
      "name": "meta",
      "tag": "span",
      "parent": "info",
      "public": true,
      "createdWhen": "size OR date",
      "description": "File metadata"
    },
    {
      "name": "download",
      "tag": "a",
      "public": true,
      "createdWhen": "downloadable AND href",
      "description": "Download link"
    }
  ],
  "$methods": {
    "show": {
      "description": "Shows the card",
      "params": []
    },
    "hide": {
      "description": "Hides the card",
      "params": []
    },
    "download": {
      "description": "Triggers download",
      "params": []
    }
  },
  "$cssAPI": {
    "--x-card-file-padding": {
      "default": "1rem",
      "description": "Card padding"
    },
    "--x-card-file-radius": {
      "default": "8px",
      "description": "Border radius"
    },
    "--x-card-file-gap": {
      "default": "1rem",
      "description": "Gap between elements"
    },
    "--x-card-file-icon-size": {
      "default": "40px",
      "description": "Icon size"
    },
    "--x-card-file-icon-bg": {
      "default": "var(--bg-secondary, #f3f4f6)",
      "description": "Icon background"
    },
    "--x-card-file-name-size": {
      "default": "0.875rem",
      "description": "Filename font size"
    },
    "--x-card-file-name-weight": {
      "default": "600",
      "description": "Filename font weight"
    },
    "--x-card-file-meta-size": {
      "default": "0.75rem",
      "description": "Meta font size"
    },
    "--x-card-file-meta-color": {
      "default": "var(--text-secondary, #666)",
      "description": "Meta text color"
    }
  },
  "test": {
    "setup": [
      "<div x-cardfile>Basic cardfile content</div>",
      "<div x-cardfile file-type=\"pdf\">fileType=pdf</div>",
      "<div x-cardfile file-type=\"doc\">fileType=doc</div>",
      "<div x-cardfile file-type=\"image\">fileType=image</div>",
      "<div x-cardfile variant=\"default\">variant=default</div>",
      "<div x-cardfile variant=\"compact\">variant=compact</div>",
      "<div x-cardfile variant=\"elevated\">variant=elevated</div>",
      "<div x-cardfile downloadable>with downloadable</div>",
      "<div filename=\"report.pdf\" file-type=\"pdf\"></div>"
    ],
    "matrix": {
      "combinations": [
        {
          "filename": "document.pdf"
        },
        {
          "filename": "document.pdf",
          "fileType": "pdf",
          "size": "1.2 MB"
        },
        {
          "filename": "photo.jpg",
          "fileType": "image",
          "size": "2.4 MB",
          "href": "/files/photo.jpg"
        }
      ]
    },
    "site": {
      "page": "cards",
      "tag": "x-cardfile",
      "renders": true,
      "baseClass": "x-card-file",
      "minInstances": 3,
      "checkText": [],
      "checkClasses": [
        "x-card-file--compact"
      ],
      "checkAttributes": [
        "filename"
      ]
    }
  },
  "_metadata": {
    "category": "cards",
    "icon": "📄",
    "since": "1.0.0",
    "status": "stable"
  }
}

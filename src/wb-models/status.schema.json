{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "status.schema.json",
  "title": "Status",
  "description": "Status-coloured inline text (primary, success, error, ...) or a window-control dot (red, yellow, green, dot). Was x-span, which still works as an alias (#1105).",
  "schemaFor": "status",
  "baseClass": "x-status",
  "semanticElement": {
    "tagName": "span",
    "implicitRole": "generic",
    "genericHost": "it is the generic inline element by definition"
  },
  "compliance": {
    "baseClass": "x-status",
    "supportLevel": "stable",
    "accessibility": "high"
  },
  "properties": {
    "variant": {
      "type": "string",
      "description": "Visual style variant",
      "enum": [
        "default",
        "red",
        "yellow",
        "green",
        "dot",
        "primary",
        "secondary",
        "success",
        "error",
        "warning",
        "info"
      ],
      "default": "default",
      "appliesClass": "x-status--{{value}}"
    }
  },
  "_metadata": {
    "category": "layout",
    "icon": "📝",
    "since": "1.0.0",
    "status": "stable",
    "generateAttribute": false
  },
  "$view": [],
  "$methods": {},
  "$cssAPI": {},
  "test": {
    "setup": [
      "<span x-status>Basic status text</span>",
      "<span x-status variant=\"red\"></span>",
      "<span x-status variant=\"yellow\"></span>",
      "<span x-status variant=\"green\"></span>",
      "<span x-status variant=\"success\">variant=success</span>",
      "<span x-status variant=\"error\">variant=error</span>"
    ]
  }
}

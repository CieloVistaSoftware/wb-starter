{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codetheme.schema.json",
  "title": "Code Theme",
  "description": "Dropdown that picks a highlight.js code theme and applies it to every code block on the page at once.",
  "schemaFor": "codetheme",
  "compliance": {
    "baseClass": "x-codetheme",
    "supportLevel": "stable",
    "accessibility": "high"
  },
  "properties": {
    "showLabel": {
      "type": "boolean",
      "description": "Show the \"Code:\" label before the theme picker.",
      "default": true
    },
    "showCategory": {
      "type": "boolean",
      "description": "Group the themes in the picker under their category headings (dark, light and so on). Set to false for one flat list.",
      "default": true
    },
    "persist": {
      "type": "boolean",
      "description": "Remember the chosen code theme in localStorage and restore it on the next visit.",
      "default": true
    }
  },
  "$view": [],
  "$methods": {},
  "$cssAPI": {},
  "test": {
    "setup": [
      "<div x-codetheme>Basic codetheme content</div>",
      "<div x-codetheme>Test permutation 2</div>",
      "<div x-codetheme>Test permutation 3</div>",
      "<div x-codetheme>Test permutation 4</div>",
      "<div x-codetheme>Test permutation 5</div>"
    ],
    "matrix": {
      "combinations": [
        {}
      ]
    },
    "site": {
      "page": "content",
      "tag": "x-codetheme",
      "renders": true,
      "baseClass": "x-codetheme",
      "minInstances": 1,
      "checkText": [],
      "checkClasses": [],
      "checkAttributes": []
    }
  }
}

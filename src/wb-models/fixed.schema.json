  "$id": "fixed.schema.json",
  "title": "Fixed",
  "description": "x-fixed pins its host to a corner, edge centre or the centre of the viewport with position: fixed.",
  "schemaFor": "fixed",
  "kind": "decorator",
  "properties": {
    "position": {
      "type": "string",
      "description": "Where the host is pinned. Any other value falls back to bottom-right.",

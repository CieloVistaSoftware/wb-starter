    },
    "offset": {
      "type": "string",
      "description": "Distance from the viewport edges, as any CSS length (`--x-fixed-offset`). Not used by center.",
      "default": "1rem"
    },
    "zIndex": {
      "type": "number",
      "description": "Stacking order of the pinned host.",
      "default": 1000
    }
  },

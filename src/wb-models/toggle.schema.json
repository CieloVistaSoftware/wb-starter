{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toggle.schema.json",
  "title": "Toggle",
  "description": "Toggle visibility or state of another element.",
  "schemaFor": "toggle",
  "compliance": {
    "baseClass": "x-toggle",
    "supportLevel": "stable",
    "accessibility": "high"
  },
  "properties": {
    "target": {
      "type": "string",
      "description": "Selector of target element",
      "default": "this is the target"
    },
    "toggleClass": {
      "type": "string",
      "description": "The class each click toggles, on `target` and, unless `toggleSelf` is false, on the element itself. It changes nothing visible unless that class is styled.",
      "default": "active"
    },
    "toggleSelf": {
      "type": "boolean",
      "description": "Also toggle the class on the clicked element itself. Set to false to change only `target`.",
      "default": true
    }
  },
  "$view": [],
  "$methods": {},
  "$cssAPI": {},
  "test": {
    "setup": [
      "<div x-toggle>Basic toggle content</div>",
      "<div x-toggle target=\"Sample target\">target=\"Sample target\"</div>",
      "<div x-toggle>Test permutation 3</div>",
      "<div x-toggle>Test permutation 4</div>",
      "<div x-toggle>Test permutation 5</div>"
    ],
    "matrix": {
      "combinations": [
        {
          "target": "#content"
        }
      ]
    },
    "site": {
      "page": "forms",
      "tag": "x-toggle",
      "renders": true,
      "baseClass": "x-toggle",
      "minInstances": 1,
      "checkText": [],
      "checkClasses": [],
      "checkAttributes": [
        "target"
      ]
    }
  }
}

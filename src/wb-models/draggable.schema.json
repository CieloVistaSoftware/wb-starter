{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "draggable.schema.json",
  "title": "Draggable",
  "description": "Make an element draggable.",
  "schemaFor": "draggable",
  "compliance": {
    "baseClass": "x-draggable",
    "supportLevel": "stable",
    "accessibility": "high"
  },
  "properties": {
    "axis": {
      "type": "string",
      "enum": [
        "x",
        "y",
        "both"
      ],
      "default": "both"
    },
    "handle": {
      "type": "string",
      "description": "Selector for drag handle",
      "default": ""
    }
  },
  "$view": [],
  "$methods": {},
  "$cssAPI": {},
  "test": {
    "setup": [
      "<div x-draggable>Basic draggable content</div>",
      "<div x-draggable axis=\"x\">axis=x</div>",
      "<div x-draggable axis=\"y\">axis=y</div>",
      "<div x-draggable axis=\"both\">axis=both</div>",
      "<div x-draggable handle=\"Sample handle\">handle=\"Sample handle\"</div>"
    ],
    "matrix": {
      "combinations": [
        {
          "axis": "both"
        },
        {
          "axis": "x"
        },
        {
          "axis": "y"
        }
      ]
    },
    "site": {
      "page": "interactive",
      "tag": "x-draggable",
      "renders": true,
      "baseClass": "x-draggable",
      "minInstances": 3,
      "checkText": [],
      "checkClasses": [],
      "checkAttributes": [
        "axis"
      ]
    }
  }
}

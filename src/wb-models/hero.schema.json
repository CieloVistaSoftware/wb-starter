{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hero.schema.json",
  "title": "Hero",
  "description": "Hero section behavior.",
  "schemaFor": "hero",
  "compliance": {
    "baseClass": "x-hero",
    "supportLevel": "stable",
    "accessibility": "high"
  },
  "properties": {
    "variant": {
      "type": "string",
      "enum": [
        "",
        "default",
        "cosmic"
      ],
      "default": "default"
    },
    "goldenRatio": {
      "type": "boolean",
      "description": "Shape the hero band as a landscape golden rectangle: width / height = 1.618, through `aspect-ratio: var(--aspect-golden)`. The width stays whatever the layout gives it and the height follows. Replaces the 400px minimum height; content taller than that still grows the band. Text sizes are unchanged. Bare attribute.",
      "default": false,
      "appliesClass": "x-hero--golden-ratio"
    }
  },
  "$view": [],
  "$methods": {},
  "$cssAPI": {},
  "test": {
    "setup": [
      "<div x-hero>Basic hero content</div>",
      "<div x-hero variant=\"default\">variant=default</div>",
      "<div x-hero variant=\"cosmic\">variant=cosmic</div>",
      "<div x-hero variant=\"default\" variant=\"cosmic\">Combined: variant=default, variant=cosmic</div>",
      "<div x-hero>Test permutation 5</div>"
    ],
    "matrix": {
      "combinations": [
        {
          "variant": "default"
        },
        {
          "variant": "cosmic"
        }
      ]
    },
    "site": {
      "page": "interactive",
      "tag": "x-hero",
      "renders": true,
      "baseClass": "x-hero",
      "minInstances": 2,
      "checkText": [],
      "checkClasses": [],
      "checkAttributes": [
        "variant"
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cardvideo.schema.json",
  "title": "Video Card",
  "description": "Card with embedded video player",
  "schemaFor": "cardvideo",
  "baseClass": "x-card-video",
  "semanticElement": {
    "tagName": "article",
    "implicitRole": "article"
  },
  "compliance": {
    "baseClass": "x-card-video",
    "supportLevel": "stable",
    "accessibility": "high"
  },
  "properties": {
    "src": {
      "type": "string",
      "description": "Video source URL",
      "required": true,
      "default": "https://upload.wikimedia.org/wikipedia/commons/f/f9/Staircase_Falls_timelapse_Yosemite_CA_2023-07-13_07-23-07_1.webm"
    },
    "poster": {
      "type": "string",
      "description": "Poster image URL",
      "default": "#"
    },
    "title": {
      "type": "string",
      "description": "Video title",
      "default": "this is the title"
    },
    "description": {
      "type": "string",
      "description": "Video description",
      "default": "this is the description"
    },
    "autoplay": {
      "type": "boolean",
      "description": "Auto-play video (requires muted)",
      "default": false,
      "visual": false,
      "visualReason": "Starts playback on load. A paused and a playing video look alike until time passes; nothing on the card marks it (#773)."
    },
    "muted": {
      "type": "boolean",
      "description": "Mute video",
      "default": false
    },
    "loop": {
      "type": "boolean",
      "description": "Loop video playback",
      "default": false,
      "visual": false,
      "visualReason": "Restarts playback at the end. Nothing is drawn for it (#773)."
    },
    "controls": {
      "type": "boolean",
      "description": "Show video controls",
      "default": true
    },
    "aspect": {
      "type": "string",
      "description": "Video aspect ratio",
      "enum": [
        "16/9",
        "4/3",
        "1/1",
        "21/9",
        "9/16"
      ],
      "default": "16/9"
    },
    "variant": {
      "type": "string",
      "description": "Visual style variant",
      "enum": [
        "default",
        "minimal",
        "bordered",
        "elevated"
      ],
      "default": "default"
    }
  },
  "$view": [
    {
      "name": "figure",
      "tag": "figure",
      "public": true,
      "required": true,
      "description": "Video container"
    },
    {
      "name": "video",
      "tag": "video",
      "parent": "figure",
      "public": true,
      "required": true,
      "description": "Video element"
    },
    {
      "name": "content",
      "tag": "div",
      "public": true,
      "createdWhen": "title OR description",
      "description": "Content container"
    },
    {
      "name": "title",
      "tag": "h3",
      "parent": "content",
      "public": true,
      "content": "{{title}}",
      "createdWhen": "title",
      "description": "Video title"
    },
    {
      "name": "description",
      "tag": "p",
      "parent": "content",
      "public": true,
      "content": "{{description}}",
      "createdWhen": "description",
      "description": "Video description"
    }
  ],
  "$methods": {
    "play": {
      "description": "Plays the video",
      "params": []
    },
    "pause": {
      "description": "Pauses the video",
      "params": []
    },
    "stop": {
      "description": "Stops and resets the video",
      "params": []
    },
    "toggle": {
      "description": "Toggles play/pause",
      "params": []
    },
    "mute": {
      "description": "Mutes the video",
      "params": []
    },
    "unmute": {
      "description": "Unmutes the video",
      "params": []
    },
    "setSource": {
      "description": "Changes the video source",
      "params": [
        "src",
        "poster"
      ]
    },
    "getCurrentTime": {
      "description": "Gets current playback time",
      "params": [],
      "returns": "number"
    },
    "setCurrentTime": {
      "description": "Seeks to time",
      "params": [
        "seconds"
      ]
    },
    "getDuration": {
      "description": "Gets video duration",
      "params": [],
      "returns": "number"
    }
  },
  "$cssAPI": {
    "--x-card-video-radius": {
      "default": "8px",
      "description": "Card border radius"
    },
    "--x-card-video-bg": {
      "default": "#000000",
      "description": "Video background color"
    },
    "--x-card-video-aspect": {
      "default": "16/9",
      "description": "Video aspect ratio"
    },
    "--x-card-video-border": {
      "default": "none",
      "description": "Card border"
    },
    "--x-card-video-shadow": {
      "default": "none",
      "description": "Card shadow"
    },
    "--x-card-video-content-padding": {
      "default": "1rem",
      "description": "Content padding"
    },
    "--x-card-video-content-bg": {
      "default": "var(--bg-surface, #ffffff)",
      "description": "Content background"
    },
    "--x-card-video-title-size": {
      "default": "1rem",
      "description": "Title font size"
    },
    "--x-card-video-title-weight": {
      "default": "600",
      "description": "Title font weight"
    },
    "--x-card-video-description-size": {
      "default": "0.875rem",
      "description": "Description font size"
    },
    "--x-card-video-description-color": {
      "default": "var(--text-secondary, #666)",
      "description": "Description color"
    }
  },
  "events": {
    "wb:cardvideo:play": {
      "description": "Fired when the video starts playing",
      "detail": {
        "currentTime": "number"
      }
    },
    "wb:cardvideo:pause": {
      "description": "Fired when the video is paused",
      "detail": {
        "currentTime": "number"
      }
    },
    "wb:cardvideo:ended": {
      "description": "Fired when video playback ends",
      "detail": {
        "currentTime": "number"
      }
    }
  },
  "test": {
    "setup": [
      "<div x-cardvideo>Basic cardvideo content</div>",
      "<div x-cardvideo aspect=\"16/9\">aspect=16/9</div>",
      "<div x-cardvideo aspect=\"4/3\">aspect=4/3</div>",
      "<div x-cardvideo aspect=\"1/1\">aspect=1/1</div>",
      "<div x-cardvideo variant=\"default\">variant=default</div>",
      "<div x-cardvideo variant=\"minimal\">variant=minimal</div>",
      "<div x-cardvideo variant=\"bordered\">variant=bordered</div>",
      "<div x-cardvideo autoplay>with autoplay</div>",
      "<div x-cardvideo title=\"Test Title\">With title attribute</div>",
      "<div x-cardvideo src=\"https://upload.wikimedia.org/wikipedia/commons/f/f9/Staircase_Falls_timelapse_Yosemite_CA_2023-07-13_07-23-07_1.webm\"></div>",
      "<div x-cardvideo src=\"https://upload.wikimedia.org/wikipedia/commons/f/f9/Staircase_Falls_timelapse_Yosemite_CA_2023-07-13_07-23-07_1.webm\" title=\"My Video\" poster=\"https://upload.wikimedia.org/wikipedia/commons/thumb/b/b4/Reflections_in_Lake_Alpine%2C_Alpine_County.jpg/1280px-Reflections_in_Lake_Alpine%2C_Alpine_County.jpg\"></div>"
    ],
    "matrix": {
      "combinations": [
        {
          "src": "https://upload.wikimedia.org/wikipedia/commons/f/f9/Staircase_Falls_timelapse_Yosemite_CA_2023-07-13_07-23-07_1.webm"
        },
        {
          "src": "https://upload.wikimedia.org/wikipedia/commons/f/f9/Staircase_Falls_timelapse_Yosemite_CA_2023-07-13_07-23-07_1.webm",
          "title": "Video Title"
        },
        {
          "src": "https://upload.wikimedia.org/wikipedia/commons/f/f9/Staircase_Falls_timelapse_Yosemite_CA_2023-07-13_07-23-07_1.webm",
          "poster": "https://upload.wikimedia.org/wikipedia/commons/thumb/b/b4/Reflections_in_Lake_Alpine%2C_Alpine_County.jpg/1280px-Reflections_in_Lake_Alpine%2C_Alpine_County.jpg"
        },
        {
          "src": "https://upload.wikimedia.org/wikipedia/commons/f/f9/Staircase_Falls_timelapse_Yosemite_CA_2023-07-13_07-23-07_1.webm",
          "autoplay": true,
          "muted": true
        },
        {
          "src": "https://upload.wikimedia.org/wikipedia/commons/f/f9/Staircase_Falls_timelapse_Yosemite_CA_2023-07-13_07-23-07_1.webm",
          "loop": true
        },
        {
          "src": "https://upload.wikimedia.org/wikipedia/commons/f/f9/Staircase_Falls_timelapse_Yosemite_CA_2023-07-13_07-23-07_1.webm",
          "controls": false
        },
        {
          "src": "https://upload.wikimedia.org/wikipedia/commons/f/f9/Staircase_Falls_timelapse_Yosemite_CA_2023-07-13_07-23-07_1.webm",
          "aspect": "4/3"
        }
      ]
    },
    "site": {
      "page": "cards",
      "tag": "x-cardvideo",
      "renders": true,
      "minInstances": 7,
      "checkText": [
        "Video Title"
      ],
      "checkClasses": [
        "x-card-video--minimal"
      ],
      "checkAttributes": [
        "src"
      ]
    }
  },
  "_metadata": {
    "category": "cards",
    "icon": "🎬",
    "since": "1.0.0",
    "status": "stable"
  }
}

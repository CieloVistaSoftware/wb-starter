{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "notes.schema.json",
  "title": "Notes",
  "description": "Slide-out notes drawer with multiple display modes",
  "schemaFor": "notes",
  "baseClass": "x-notes",
  "semanticElement": {
    "tagName": "aside"
  },
  "compliance": {
    "baseClass": "x-notes",
    "supportLevel": "stable",
    "accessibility": "high"
  },
  "properties": {
    "position": {
      "type": "string",
      "enum": [
        "left",
        "right",
        "modal"
      ],
      "default": "left",
      "appliesClass": "x-notes--{{value}}",
      "visibleWhen": "open",
      "visualReason": "Places the notes drawer, which is on screen only once opened (#773)."
    },
    "maxWidth": {
      "type": "string",
      "description": "Max width when resizing",
      "default": "50vw"
    },
    "minWidth": {
      "type": "string",
      "description": "Min width when resizing",
      "default": "200px"
    },
    "defaultWidth": {
      "type": "string",
      "description": "Default width",
      "default": "320px"
    },
    "autoSave": {
      "type": "boolean",
      "description": "Auto-save to localStorage",
      "default": true,
      "visual": false,
      "visualReason": "Saves the notes to localStorage as they are typed. Nothing is drawn for it (#773)."
    },
    "placeholder": {
      "type": "string",
      "description": "Textarea placeholder",
      "default": "Add your notes here..."
    },
    "savePath": {
      "type": "string",
      "description": "URL of the notes file: the panel loads saved notes from it and names it in the \"Saved to\" message.",
      "default": "/data/notes.json"
    }
  },
  "$view": [
    {
      "name": "backdrop",
      "tag": "div",
      "public": false,
      "createdWhen": "position == 'modal'",
      "description": "Modal backdrop"
    },
    {
      "name": "drawer",
      "tag": "div",
      "public": true,
      "required": true,
      "description": "Main drawer container"
    },
    {
      "name": "header",
      "tag": "header",
      "parent": "drawer",
      "public": true,
      "description": "Header with title and actions"
    },
    {
      "name": "title",
      "tag": "h3",
      "parent": "header",
      "public": true,
      "description": "Notes title"
    },
    {
      "name": "actions",
      "tag": "div",
      "parent": "header",
      "public": true,
      "description": "Action buttons row"
    },
    {
      "name": "textarea",
      "tag": "textarea",
      "parent": "drawer",
      "public": true,
      "required": true,
      "description": "Notes input"
    },
    {
      "name": "footer",
      "tag": "footer",
      "parent": "drawer",
      "public": true,
      "description": "Footer with status"
    },
    {
      "name": "resize-handle",
      "tag": "div",
      "parent": "drawer",
      "public": false,
      "description": "Resize handle"
    }
  ],
  "$methods": {
    "show": {
      "description": "Opens the drawer",
      "params": []
    },
    "hide": {
      "description": "Closes the drawer; hide(side) docks it to that side first",
      "params": [
        "side"
      ]
    },
    "toggle": {
      "description": "Toggles drawer",
      "params": []
    },
    "setPosition": {
      "description": "Sets position",
      "params": [
        "position"
      ]
    },
    "save": {
      "description": "Saves notes to JSON",
      "params": []
    },
    "copy": {
      "description": "Copies notes to clipboard",
      "params": []
    },
    "clear": {
      "description": "Clears all notes",
      "params": []
    },
    "getContent": {
      "description": "Gets notes content",
      "params": [],
      "returns": "string"
    },
    "setContent": {
      "description": "Sets notes content",
      "params": [
        "content"
      ]
    }
  },
  "$cssAPI": {
    "--x-notes-width": {
      "default": "320px",
      "description": "Default width"
    },
    "--x-notes-max-width": {
      "default": "50vw",
      "description": "Max width"
    },
    "--x-notes-min-width": {
      "default": "200px",
      "description": "Min width"
    },
    "--x-notes-bg": {
      "default": "var(--bg-surface, #ffffff)",
      "description": "Background"
    },
    "--x-notes-border": {
      "default": "1px solid var(--border-color, #e0e0e0)",
      "description": "Border"
    },
    "--x-notes-shadow": {
      "default": "0 4px 20px rgba(0,0,0,0.15)",
      "description": "Shadow"
    },
    "--x-notes-header-bg": {
      "default": "var(--bg-secondary, #f3f4f6)",
      "description": "Header background"
    },
    "--x-notes-z-index": {
      "default": "1000",
      "description": "Z-index"
    }
  },
  "events": {
    "wb:notes:open": {
      "description": "Drawer opened"
    },
    "wb:notes:close": {
      "description": "Drawer closed"
    },
    "wb:notes:save": {
      "description": "Notes saved",
      "detail": {
        "content": "string"
      }
    },
    "wb:notes:copy": {
      "description": "Notes copied to clipboard"
    },
    "wb:notes:clear": {
      "description": "Notes cleared"
    },
    "wb:notes:position": {
      "description": "Position changed",
      "detail": {
        "position": "string"
      }
    }
  },
  "test": {
    "setup": [
      "<div x-notes>Basic notes content</div>",
      "<div x-notes position=\"left\">position=left</div>",
      "<div x-notes position=\"right\">position=right</div>",
      "<div x-notes position=\"modal\">position=modal</div>",
      "<div x-notes autoSave>with autoSave</div>",
      "<div x-notes maxWidth=\"50vw\">maxWidth=\"50vw\"</div>",
      "<div x-notes minWidth=\"200px\">minWidth=\"200px\"</div>",
      "<div x-notes defaultWidth=\"320px\">defaultWidth=\"320px\"</div>"
    ],
    "matrix": {
      "combinations": [
        {},
        {
          "position": "left"
        },
        {
          "position": "right"
        },
        {
          "position": "modal"
        }
      ]
    },
    "site": {
      "page": "content",
      "tag": "x-notes",
      "renders": true,
      "baseClass": "x-notes",
      "minInstances": 4,
      "checkText": [],
      "checkClasses": [
        "x-notes--right"
      ],
      "checkAttributes": []
    }
  },
  "_metadata": {
    "category": "utility",
    "icon": "📝",
    "since": "1.0.0",
    "status": "stable"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "avatar.schema.json",
  "title": "Avatar",
  "description": "User avatar with image, initials fallback, and status indicator",
  "schemaFor": "avatar",
  "baseClass": "x-avatar",
  "semanticElement": {
    "tagName": "div",
    "implicitRole": "img"
  },
  "compliance": {
    "baseClass": "x-avatar",
    "supportLevel": "stable",
    "accessibility": "high"
  },
  "properties": {
    "src": {
      "type": "string",
      "description": "Image source URL",
      "default": ""
    },
    "alt": {
      "type": "string",
      "description": "Alt text for image",
      "default": ""
    },
    "initials": {
      "type": "string",
      "description": "Fallback initials (2 chars)",
      "default": ""
    },
    "name": {
      "type": "string",
      "description": "Full name (generates initials if not provided)",
      "default": ""
    },
    "size": {
      "type": "string",
      "enum": [
        "xs",
        "sm",
        "md",
        "lg",
        "xl",
        "2xl"
      ],
      "default": "md",
      "appliesClass": "x-avatar--{{value}}"
    },
    "shape": {
      "type": "string",
      "enum": [
        "circle",
        "square",
        "rounded"
      ],
      "default": "circle",
      "appliesClass": "x-avatar--{{value}}"
    },
    "status": {
      "type": "string",
      "enum": [
        "",
        "online",
        "offline",
        "busy",
        "away"
      ],
      "description": "Status indicator (empty = no indicator)",
      "default": ""
    },
    "bordered": {
      "type": "boolean",
      "description": "Show border",
      "default": false,
      "appliesClass": "x-avatar--bordered"
    }
  },
  "$view": [],
  "$methods": {
    "setImage": {
      "description": "Sets the image source",
      "params": [
        "src",
        "alt"
      ]
    },
    "setInitials": {
      "description": "Sets initials",
      "params": [
        "initials"
      ]
    },
    "setStatus": {
      "description": "Sets status",
      "params": [
        "status"
      ]
    },
    "clearStatus": {
      "description": "Removes status indicator",
      "params": []
    }
  },
  "$cssAPI": {
    "--x-avatar-size": {
      "default": "40px",
      "description": "Avatar size"
    },
    "--x-avatar-bg": {
      "default": "var(--bg-secondary, #e5e7eb)",
      "description": "Background (for initials)"
    },
    "--x-avatar-color": {
      "default": "var(--text-secondary, #6b7280)",
      "description": "Initials text color"
    },
    "--x-avatar-font-size": {
      "default": "0.875rem",
      "description": "Initials font size"
    },
    "--x-avatar-font-weight": {
      "default": "600",
      "description": "Initials font weight"
    },
    "--x-avatar-border": {
      "default": "2px solid var(--bg-surface, #ffffff)",
      "description": "Border style"
    },
    "--x-avatar-radius": {
      "default": "50%",
      "description": "Border radius"
    },
    "--x-avatar-status-size": {
      "default": "12px",
      "description": "Status indicator size"
    },
    "--x-avatar-status-online": {
      "default": "#22c55e",
      "description": "Online status color"
    },
    "--x-avatar-status-offline": {
      "default": "#9ca3af",
      "description": "Offline status color"
    },
    "--x-avatar-status-busy": {
      "default": "#ef4444",
      "description": "Busy status color"
    },
    "--x-avatar-status-away": {
      "default": "#f59e0b",
      "description": "Away status color"
    }
  },
  "accessibility": {
    "role": "img",
    "ariaLabel": "dynamic from name or alt"
  },
  "test": {
    "setup": [
      "<span x-avatar>Basic avatar content</span>",
      "<span x-avatar size=\"xs\">size=xs</span>",
      "<span x-avatar size=\"sm\">size=sm</span>",
      "<span x-avatar size=\"md\">size=md</span>",
      "<span x-avatar shape=\"circle\">shape=circle</span>",
      "<span x-avatar shape=\"square\">shape=square</span>",
      "<span x-avatar shape=\"rounded\">shape=rounded</span>",
      "<span x-avatar status=\"online\">status=online</span>"
    ],
    "matrix": {
      "combinations": [
        {
          "initials": "JD"
        },
        {
          "src": "https://i.pravatar.cc/150?u=avatar1"
        },
        {
          "initials": "JD",
          "size": "lg"
        },
        {
          "initials": "JD",
          "status": "online"
        },
        {
          "initials": "JD",
          "shape": "square"
        }
      ]
    },
    "site": {
      "page": "feedback",
      "tag": "x-avatar",
      "renders": true,
      "baseClass": "x-avatar",
      "minInstances": 5,
      "checkText": [],
      "checkClasses": [
        "x-avatar--xs",
        "x-avatar--square"
      ],
      "checkAttributes": [
        "initials"
      ]
    }
  },
  "_metadata": {
    "category": "feedback",
    "icon": "👤",
    "since": "1.0.0",
    "status": "stable"
  }
}

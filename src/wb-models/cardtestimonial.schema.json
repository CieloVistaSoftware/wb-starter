{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cardtestimonial.schema.json",
  "title": "Testimonial Card",
  "description": "Customer testimonial/review card with quote, author, avatar, and rating",
  "schemaFor": "cardtestimonial",
  "baseClass": "x-testimonial",
  "semanticElement": {
    "tagName": "article",
    "implicitRole": "article"
  },
  "compliance": {
    "baseClass": "x-testimonial",
    "supportLevel": "stable",
    "accessibility": "high"
  },
  "properties": {
    "quote": {
      "type": "string",
      "description": "Testimonial quote text",
      "required": true,
      "default": ""
    },
    "author": {
      "type": "string",
      "description": "Author name",
      "required": true,
      "default": ""
    },
    "role": {
      "type": "string",
      "description": "Author role/title/company",
      "default": ""
    },
    "avatar": {
      "type": "string",
      "description": "Author avatar image URL",
      "default": ""
    },
    "rating": {
      "type": "number",
      "description": "Star rating (0-5)",
      "minimum": 0,
      "maximum": 5,
      "default": 0
    },
    "variant": {
      "type": "string",
      "description": "Visual style variant",
      "enum": [
        "default",
        "elevated",
        "bordered",
        "minimal",
        "centered"
      ],
      "default": "default",
      "appliesClass": "x-testimonial--{{value}}"
    },
    "size": {
      "type": "string",
      "description": "Card size",
      "enum": [
        "sm",
        "md",
        "lg"
      ],
      "default": "md",
      "appliesClass": "x-testimonial--{{value}}"
    }
  },
  "$view": [
    {
      "name": "rating",
      "tag": "p",
      "public": true,
      "createdWhen": "rating",
      "description": "Star rating display"
    },
    {
      "name": "quote",
      "tag": "blockquote",
      "public": true,
      "required": true,
      "description": "Semantic blockquote for testimonial"
    },
    {
      "name": "quote-text",
      "tag": "p",
      "parent": "quote",
      "public": true,
      "content": "{{quote}}",
      "description": "Quote text content"
    },
    {
      "name": "footer",
      "tag": "footer",
      "public": true,
      "required": true,
      "description": "Attribution footer"
    },
    {
      "name": "avatar-wrapper",
      "tag": "figure",
      "parent": "footer",
      "public": true,
      "createdWhen": "avatar",
      "description": "Avatar container"
    },
    {
      "name": "avatar",
      "tag": "img",
      "parent": "avatar-wrapper",
      "public": true,
      "createdWhen": "avatar",
      "description": "Author avatar image"
    },
    {
      "name": "attribution",
      "tag": "div",
      "parent": "footer",
      "public": false,
      "required": true,
      "description": "Author info container"
    },
    {
      "name": "author",
      "tag": "cite",
      "parent": "attribution",
      "public": true,
      "content": "{{author}}",
      "description": "Author name (semantic cite)"
    },
    {
      "name": "role",
      "tag": "span",
      "parent": "attribution",
      "public": true,
      "content": "{{role}}",
      "createdWhen": "role",
      "description": "Author role/title"
    }
  ],
  "$methods": {
    "show": {
      "description": "Shows the testimonial card",
      "params": []
    },
    "hide": {
      "description": "Hides the testimonial card",
      "params": []
    },
    "toggle": {
      "description": "Toggles visibility",
      "params": []
    },
    "setRating": {
      "description": "Updates the star rating",
      "params": [
        "rating"
      ]
    }
  },
  "$cssAPI": {
    "--x-testimonial-padding": {
      "default": "1.5rem",
      "description": "Card padding"
    },
    "--x-testimonial-radius": {
      "default": "8px",
      "description": "Border radius"
    },
    "--x-testimonial-bg": {
      "default": "var(--bg-surface, #ffffff)",
      "description": "Card background"
    },
    "--x-testimonial-border": {
      "default": "none",
      "description": "Card border"
    },
    "--x-testimonial-shadow": {
      "default": "none",
      "description": "Card shadow"
    },
    "--x-testimonial-gap": {
      "default": "1rem",
      "description": "Gap between elements"
    },
    "--x-testimonial-quote-size": {
      "default": "1rem",
      "description": "Quote text font size"
    },
    "--x-testimonial-quote-color": {
      "default": "var(--text-primary, #1a1a1a)",
      "description": "Quote text color"
    },
    "--x-testimonial-quote-style": {
      "default": "italic",
      "description": "Quote font style"
    },
    "--x-testimonial-quote-line-height": {
      "default": "1.6",
      "description": "Quote line height"
    },
    "--x-testimonial-quote-mark": {
      "default": "“",
      "description": "Opening quote character"
    },
    "--x-testimonial-quote-mark-size": {
      "default": "3rem",
      "description": "Quote mark font size"
    },
    "--x-testimonial-quote-mark-color": {
      "default": "var(--primary, #6366f1)",
      "description": "Quote mark color"
    },
    "--x-testimonial-avatar-size": {
      "default": "48px",
      "description": "Avatar size"
    },
    "--x-testimonial-avatar-radius": {
      "default": "50%",
      "description": "Avatar border radius"
    },
    "--x-testimonial-author-size": {
      "default": "1rem",
      "description": "Author name font size"
    },
    "--x-testimonial-author-weight": {
      "default": "600",
      "description": "Author name font weight"
    },
    "--x-testimonial-author-color": {
      "default": "var(--text-primary, #1a1a1a)",
      "description": "Author name color"
    },
    "--x-testimonial-role-size": {
      "default": "0.875rem",
      "description": "Role font size"
    },
    "--x-testimonial-role-color": {
      "default": "var(--text-secondary, #666)",
      "description": "Role text color"
    },
    "--x-testimonial-star-color": {
      "default": "var(--warning, #ffc107)",
      "description": "Filled star color"
    },
    "--x-testimonial-star-empty-color": {
      "default": "var(--border-color, #e0e0e0)",
      "description": "Empty star color"
    },
    "--x-testimonial-star-size": {
      "default": "1rem",
      "description": "Star size"
    }
  },
  "accessibility": {
    "avatar": {
      "alt": "Photo of {{author}}"
    },
    "rating": {
      "ariaLabel": "{{rating}} out of 5 stars"
    }
  },
  "test": {
    "setup": [
      "<div x-cardtestimonial>Basic cardtestimonial content</div>",
      "<div x-cardtestimonial variant=\"default\">variant=default</div>",
      "<div x-cardtestimonial variant=\"elevated\">variant=elevated</div>",
      "<div x-cardtestimonial variant=\"bordered\">variant=bordered</div>",
      "<div x-cardtestimonial size=\"sm\">size=sm</div>",
      "<div x-cardtestimonial size=\"md\">size=md</div>",
      "<div x-cardtestimonial size=\"lg\">size=lg</div>",
      "<div x-cardtestimonial quote=\"Sample quote\">quote=\"Sample quote\"</div>",
      "<div x-cardtestimonial quote=\"Great product!\" author=\"John Doe\"></div>",
      "<div x-cardtestimonial quote=\"Amazing!\" author=\"Jane\" role=\"CEO\" avatar=\"avatar.jpg\" rating=\"5\"></div>"
    ],
    "matrix": {
      "combinations": [
        {
          "quote": "Great!",
          "author": "John"
        },
        {
          "quote": "Great!",
          "author": "John",
          "role": "CEO"
        },
        {
          "quote": "Great!",
          "author": "John",
          "avatar": "https://i.pravatar.cc/150?u=john"
        },
        {
          "quote": "Great!",
          "author": "John",
          "rating": 5
        },
        {
          "quote": "Great!",
          "author": "John",
          "rating": 3
        },
        {
          "quote": "Excellent service!",
          "author": "Jane",
          "role": "CTO at Acme",
          "avatar": "https://i.pravatar.cc/150?u=jane",
          "rating": 5
        },
        {
          "quote": "Great!",
          "author": "John",
          "variant": "elevated"
        },
        {
          "quote": "Great!",
          "author": "John",
          "variant": "centered"
        }
      ]
    },
    "site": {
      "page": "cards",
      "tag": "x-cardtestimonial",
      "renders": true,
      "baseClass": "x-testimonial",
      "minInstances": 8,
      "checkText": [],
      "checkClasses": [
        "x-testimonial--elevated",
        "x-testimonial--sm"
      ],
      "checkAttributes": [
        "quote",
        "author"
      ]
    }
  },
  "_metadata": {
    "category": "cards",
    "icon": "💬",
    "since": "1.0.0",
    "status": "stable"
  }
}

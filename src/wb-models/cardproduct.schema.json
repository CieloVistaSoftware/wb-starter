{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cardproduct.schema.json",
  "title": "Product Card",
  "description": "E-commerce product card with image, price, rating, and CTA",
  "schemaFor": "cardproduct",
  "baseClass": "x-product",
  "semanticElement": {
    "tagName": "article",
    "implicitRole": "article"
  },
  "compliance": {
    "baseClass": "x-product",
    "supportLevel": "stable",
    "accessibility": "high"
  },
  "properties": {
    "image": {
      "type": "string",
      "description": "Product image URL",
      "default": ""
    },
    "title": {
      "type": "string",
      "description": "Product name",
      "required": true,
      "default": ""
    },
    "description": {
      "type": "string",
      "description": "Product description",
      "default": ""
    },
    "price": {
      "type": "string",
      "description": "Current price",
      "required": true,
      "default": ""
    },
    "originalPrice": {
      "type": "string",
      "description": "Original price (shows discount)",
      "default": ""
    },
    "badge": {
      "type": "string",
      "description": "Badge text (Sale, New, etc.)",
      "default": ""
    },
    "rating": {
      "type": "number",
      "description": "Product rating (0-5)",
      "default": 0
    },
    "reviews": {
      "type": "number",
      "description": "Number of reviews",
      "default": 0
    },
    "cta": {
      "type": "string",
      "description": "CTA button text",
      "default": "Add to Cart"
    },
    "featured": {
      "type": "boolean",
      "description": "Highlight as featured",
      "default": false,
      "appliesClass": "x-product--featured"
    },
    "variant": {
      "type": "string",
      "description": "Visual style variant",
      "enum": [
        "default",
        "compact",
        "horizontal",
        "minimal"
      ],
      "default": "default",
      "appliesClass": "x-product--{{value}}"
    }
  },
  "$view": [
    {
      "name": "figure",
      "tag": "figure",
      "public": true,
      "createdWhen": "image",
      "description": "Product image container"
    },
    {
      "name": "image",
      "tag": "img",
      "parent": "figure",
      "public": true,
      "createdWhen": "image",
      "description": "Product image"
    },
    {
      "name": "badge",
      "tag": "span",
      "parent": "figure",
      "public": true,
      "content": "{{badge}}",
      "createdWhen": "badge",
      "description": "Product badge"
    },
    {
      "name": "content",
      "tag": "div",
      "public": true,
      "required": true,
      "description": "Product info container"
    },
    {
      "name": "title",
      "tag": "h3",
      "parent": "content",
      "public": true,
      "content": "{{title}}",
      "description": "Product name"
    },
    {
      "name": "description",
      "tag": "p",
      "parent": "content",
      "public": true,
      "content": "{{description}}",
      "createdWhen": "description",
      "description": "Product description"
    },
    {
      "name": "rating-wrapper",
      "tag": "div",
      "parent": "content",
      "public": true,
      "createdWhen": "rating",
      "description": "Rating container"
    },
    {
      "name": "price-wrapper",
      "tag": "div",
      "parent": "content",
      "public": false,
      "required": true,
      "description": "Price container"
    },
    {
      "name": "price",
      "tag": "data",
      "parent": "price-wrapper",
      "public": true,
      "content": "{{price}}",
      "description": "Current price (semantic data element)"
    },
    {
      "name": "original-price",
      "tag": "data",
      "parent": "price-wrapper",
      "public": true,
      "content": "{{originalPrice}}",
      "createdWhen": "originalPrice",
      "description": "Original price (strikethrough)"
    },
    {
      "name": "footer",
      "tag": "footer",
      "public": true,
      "required": true,
      "description": "CTA container"
    },
    {
      "name": "cta",
      "tag": "button",
      "parent": "footer",
      "public": true,
      "content": "{{cta}}",
      "description": "Add to cart button"
    }
  ],
  "$methods": {
    "show": {
      "description": "Shows the card",
      "params": []
    },
    "hide": {
      "description": "Hides the card",
      "params": []
    },
    "toggle": {
      "description": "Toggles visibility",
      "params": []
    },
    "addToCart": {
      "description": "Triggers add to cart action",
      "params": []
    },
    "updatePrice": {
      "description": "Updates the price",
      "params": [
        "price",
        "originalPrice"
      ]
    },
    "setBadge": {
      "description": "Sets the badge text",
      "params": [
        "text"
      ]
    }
  },
  "$cssAPI": {
    "--x-product-radius": {
      "default": "8px",
      "description": "Card border radius"
    },
    "--x-product-bg": {
      "default": "var(--bg-surface, #ffffff)",
      "description": "Card background"
    },
    "--x-product-border": {
      "default": "1px solid var(--border-color, #e0e0e0)",
      "description": "Card border"
    },
    "--x-product-shadow": {
      "default": "none",
      "description": "Card shadow"
    },
    "--x-product-padding": {
      "default": "1rem",
      "description": "Content padding"
    },
    "--x-product-gap": {
      "default": "0.75rem",
      "description": "Gap between elements"
    },
    "--x-product-image-aspect": {
      "default": "4/3",
      "description": "Image aspect ratio"
    },
    "--x-product-image-radius": {
      "default": "8px 8px 0 0",
      "description": "Image border radius"
    },
    "--x-product-title-size": {
      "default": "1rem",
      "description": "Title font size"
    },
    "--x-product-title-weight": {
      "default": "600",
      "description": "Title font weight"
    },
    "--x-product-description-size": {
      "default": "0.875rem",
      "description": "Description font size"
    },
    "--x-product-description-color": {
      "default": "var(--text-secondary, #666)",
      "description": "Description color"
    },
    "--x-product-price-size": {
      "default": "1.25rem",
      "description": "Price font size"
    },
    "--x-product-price-weight": {
      "default": "700",
      "description": "Price font weight"
    },
    "--x-product-price-color": {
      "default": "var(--text-primary, #1a1a1a)",
      "description": "Price color"
    },
    "--x-product-original-price-color": {
      "default": "var(--text-tertiary, #999)",
      "description": "Original price color"
    },
    "--x-product-badge-bg": {
      "default": "var(--error, #ef4444)",
      "description": "Badge background"
    },
    "--x-product-badge-color": {
      "default": "#ffffff",
      "description": "Badge text color"
    },
    "--x-product-rating-color": {
      "default": "var(--warning, #ffc107)",
      "description": "Rating star color"
    },
    "--x-product-cta-bg": {
      "default": "var(--primary, #6366f1)",
      "description": "CTA button background"
    },
    "--x-product-cta-color": {
      "default": "#ffffff",
      "description": "CTA button text color"
    }
  },
  "events": {
    "wb:cardproduct:addtocart": {
      "description": "Fired when add to cart is clicked",
      "detail": {
        "title": "string",
        "price": "string",
        "id": "string"
      }
    }
  },
  "test": {
    "setup": [
      "<div x-cardproduct>Basic cardproduct content</div>",
      "<div x-cardproduct variant=\"default\">variant=default</div>",
      "<div x-cardproduct variant=\"compact\">variant=compact</div>",
      "<div x-cardproduct variant=\"horizontal\">variant=horizontal</div>",
      "<div x-cardproduct featured>with featured</div>",
      "<div x-cardproduct image=\"/images/dachshund-puppy-image-960x540.jpg\">image=\"/images/dachshund-puppy-image-960x540.jpg\"</div>",
      "<div x-cardproduct title=\"Sample title\">title=\"Sample title\"</div>",
      "<div x-cardproduct description=\"Sample description\">description=\"Sample description\"</div>",
      "<div x-cardproduct title=\"Widget\" price=\"$29\"></div>",
      "<div x-cardproduct image=\"/images/dachshund-puppy-image-960x540.jpg\" title=\"Widget\" price=\"$19\" badge=\"Sale\"></div>"
    ],
    "matrix": {
      "combinations": [
        {
          "title": "Product",
          "price": "$29"
        },
        {
          "title": "Product",
          "price": "$29",
          "originalPrice": "$49"
        },
        {
          "image": "/images/dachshund-puppy-image-960x540.jpg",
          "title": "Product",
          "price": "$29"
        },
        {
          "title": "Product",
          "price": "$29",
          "rating": 4.5,
          "reviews": 128
        },
        {
          "title": "Product",
          "price": "$29",
          "badge": "Sale",
          "featured": true
        }
      ]
    },
    "site": {
      "page": "cards",
      "tag": "x-cardproduct",
      "renders": true,
      "baseClass": "x-product",
      "minInstances": 5,
      "checkText": [
        "Product"
      ],
      "checkClasses": [
        "x-product--compact"
      ],
      "checkAttributes": [
        "title",
        "price"
      ]
    }
  },
  "_metadata": {
    "category": "cards",
    "icon": "🛒",
    "since": "1.0.0",
    "status": "stable"
  }
}

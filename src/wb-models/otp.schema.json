{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OTP Behavior",
  "schemaFor": "otp",
  "schemaType": "component",
  "type": "object",
  "description": "x-otp replaces the element's content with length single-digit boxes for a one-time code: typing moves to the next box, and non-digits are rejected.",
  "properties": {
    "length": {
      "type": "integer",
      "description": "Number of OTP digits",
      "default": 0,
      "examples": [
        3,
        4,
        5,
        6,
        8
      ]
    }
  },
  "required": [],
  "wbBehavior": {
    "name": "otp",
    "type": "modifier",
    "category": "inputs",
    "description": "Renders a multi-input OTP field.",
    "src": "src/wb-viewmodels/otp.js"
  },
  "$view": [],
  "$methods": {}
}

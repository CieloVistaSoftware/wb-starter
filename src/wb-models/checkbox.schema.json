{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "checkbox.schema.json",
  "title": "Checkbox",
  "description": "Checkbox input with label and custom styling",
  "schemaFor": "checkbox",
  "baseClass": "x-checkbox",
  "semanticElement": {
    "tagName": "div",
    "implicitRole": "checkbox"
  },
  "compliance": {
    "baseClass": "x-checkbox",
    "supportLevel": "deprecated",
    "accessibility": "high"
  },
  "deprecated": "Use a bare <input type=\"checkbox\"> directly -- checkbox.js's behavior already enhances it fully (custom styling via appearance:none, no wrapper element needed). Retained for back-compat only.",
  "properties": {
    "label": {
      "type": "string",
      "description": "Label text",
      "default": ""
    },
    "checked": {
      "type": "boolean",
      "description": "Checked state",
      "default": false,
      "appliesClass": "x-checkbox--checked"
    },
    "disabled": {
      "type": "boolean",
      "description": "Disabled state",
      "default": false
    },
    "indeterminate": {
      "type": "boolean",
      "description": "Indeterminate state",
      "default": false
    },
    "name": {
      "type": "string",
      "description": "Form field name",
      "default": ""
    },
    "value": {
      "type": "string",
      "description": "Form field value",
      "default": ""
    },
    "required": {
      "type": "boolean",
      "description": "Required field",
      "default": false
    },
    "size": {
      "type": "string",
      "enum": [
        "sm",
        "md",
        "lg"
      ],
      "default": "md",
      "appliesClass": "x-checkbox--{{value}}"
    },
    "variant": {
      "type": "string",
      "enum": [
        "default",
        "primary",
        "success"
      ],
      "default": "default",
      "appliesClass": "x-checkbox--{{value}}"
    }
  },
  "$view": [
    {
      "name": "input",
      "tag": "input",
      "public": false,
      "required": true,
      "attributes": { "type": "checkbox" },
      "description": "Hidden native checkbox"
    },
    {
      "name": "box",
      "tag": "span",
      "public": true,
      "required": true,
      "description": "Visual checkbox element"
    },
    {
      "name": "check",
      "tag": "span",
      "parent": "box",
      "public": false,
      "description": "Checkmark icon"
    },
    {
      "name": "label",
      "tag": "span",
      "public": true,
      "content": "{{label}}",
      "createdWhen": "label",
      "description": "Label text"
    }
  ],
  "$methods": {
    "check": {
      "description": "Checks the checkbox",
      "params": []
    },
    "uncheck": {
      "description": "Unchecks the checkbox",
      "params": []
    },
    "toggle": {
      "description": "Toggles checked state",
      "params": []
    },
    "isChecked": {
      "description": "Returns checked state",
      "params": [],
      "returns": "boolean"
    },
    "enable": {
      "description": "Enables the checkbox",
      "params": []
    },
    "disable": {
      "description": "Disables the checkbox",
      "params": []
    }
  },
  "$cssAPI": {
    "--x-checkbox-size": {
      "default": "18px",
      "description": "Checkbox size"
    },
    "--x-checkbox-radius": {
      "default": "4px",
      "description": "Border radius"
    },
    "--x-checkbox-border": {
      "default": "2px solid var(--border-color, #d1d5db)",
      "description": "Border style"
    },
    "--x-checkbox-bg": {
      "default": "var(--bg-surface, #ffffff)",
      "description": "Background"
    },
    "--x-checkbox-checked-bg": {
      "default": "var(--primary, #6366f1)",
      "description": "Checked background"
    },
    "--x-checkbox-checked-border": {
      "default": "var(--primary, #6366f1)",
      "description": "Checked border"
    },
    "--x-checkbox-check-color": {
      "default": "#ffffff",
      "description": "Checkmark color"
    },
    "--x-checkbox-disabled-opacity": {
      "default": "0.5",
      "description": "Disabled opacity"
    },
    "--x-checkbox-label-gap": {
      "default": "0.5rem",
      "description": "Gap between box and label"
    },
    "--x-checkbox-label-size": {
      "default": "0.875rem",
      "description": "Label font size"
    },
    "--x-checkbox-focus-ring": {
      "default": "0 0 0 3px rgba(99, 102, 241, 0.2)",
      "description": "Focus ring"
    }
  },
  "events": {
    "wb:checkbox:change": {
      "description": "Fired when state changes",
      "detail": {
        "checked": "boolean"
      }
    }
  },
  "test": {
    "setup": [
      "<div x-checkbox>Basic checkbox content</div>",
      "<div x-checkbox size=\"sm\">size=sm</div>",
      "<div x-checkbox size=\"md\">size=md</div>",
      "<div x-checkbox size=\"lg\">size=lg</div>",
      "<div x-checkbox variant=\"default\">variant=default</div>",
      "<div x-checkbox variant=\"primary\">variant=primary</div>",
      "<div x-checkbox variant=\"success\">variant=success</div>",
      "<div x-checkbox checked>with checked</div>"
    ],
    "functional": {
      "interactions": [
        {
          "name": "Toggle Checkbox",
          "setup": "<div x-checkbox label='Toggle'></div>",
          "action": "click",
          "expect": {
            "event": "wb:checkbox:change",
            "checked": true,
            "hasClass": "x-checkbox--checked"
          }
        }
      ],
      "visual": [
        {
          "name": "Checked State",
          "setup": "<div x-checkbox label='Checked' checked></div>",
          "expect": {
            "checked": true,
            "hasClass": "x-checkbox--checked"
          }
        }
      ],
      "disabled": [
        {
          "name": "Disabled State",
          "setup": "<div x-checkbox label='Disabled' disabled></div>",
          "action": "click",
          "expect": {
            "event": null,
            "checked": false
          }
        }
      ],
      "focus": [
        {
          "name": "Focus Handling",
          "setup": "<div x-checkbox label='Focus'></div>",
          "action": "click",
          "expect": {
            "focused": "input"
          }
        }
      ],
      "keyboard": [
        {
          "name": "Space to Toggle",
          "setup": "<div x-checkbox label='Keyboard'></div>",
          "key": "Space",
          "expect": {
            "event": "wb:checkbox:change",
            "checked": true
          }
        }
      ]
    },
    "matrix": {
      "combinations": [
        {
          "label": "Default checkbox"
        },
        {
          "label": "Checked",
          "checked": true
        },
        {
          "label": "Disabled",
          "disabled": true
        },
        {
          "label": "Primary",
          "variant": "primary"
        },
        {
          "label": "Success variant",
          "variant": "success",
          "checked": true
        },
        {
          "label": "Small checkbox",
          "size": "sm"
        },
        {
          "label": "Large checkbox",
          "size": "lg"
        }
      ]
    },
    "site": {
      "page": "forms",
      "tag": "x-checkbox",
      "renders": true,
      "baseClass": "x-checkbox",
      "minInstances": 7,
      "checkText": [
        "Default checkbox",
        "Checked",
        "Disabled",
        "Primary"
      ],
      "checkClasses": [
        "x-checkbox--sm",
        "x-checkbox--primary"
      ],
      "checkAttributes": [
        "label"
      ]
    }
  },
  "_metadata": {
    "category": "forms",
    "icon": "☑️",
    "since": "1.0.0",
    "status": "deprecated"
  }
}

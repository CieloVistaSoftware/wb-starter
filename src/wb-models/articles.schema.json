{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "articles.schema.json",
  "title": "Articles List Component",
  "description": "A wrapper component to display a list or grid of articles.",
  "schemaFor": "articles",
  "baseClass": "x-articles",
  "semanticElement": {
    "tagName": "section",
    "implicitRole": "feed"
  },
  "compliance": {
    "baseClass": "x-articles",
    "supportLevel": "stable",
    "accessibility": "high"
  },
  "properties": {
    "layout": {
      "type": "string",
      "description": "Layout mode: grid, list, or masonry",
      "enum": [
        "grid",
        "list",
        "masonry"
      ],
      "default": "grid"
    },
    "columns": {
      "type": "number",
      "description": "Number of columns for grid layout",
      "default": 3
    },
    "limit": {
      "type": "number",
      "description": "Maximum number of articles to show",
      "default": 10
    },
    "source": {
      "type": "string",
      "description": "Data source URL for fetching articles dynamically",
      "default": ""
    },
    "pagination": {
      "type": "boolean",
      "description": "Enable pagination",
      "default": false
    }
  },
  "$view": [
    {
      "name": "header",
      "tag": "header",
      "class": "x-articles__header",
      "createdWhen": "title"
    },
    {
      "name": "title",
      "tag": "h2",
      "parent": "header",
      "content": "{{title}}",
      "createdWhen": "title"
    },
    {
      "name": "list",
      "tag": "div",
      "class": "x-articles__list x-articles--{{layout}}",
      "content": "{{slot}}"
    }
  ],
  "$cssAPI": {},
  "test": {
    "setup": [
      "<div x-articles>Basic articles content</div>",
      "<div x-articles layout=\"grid\">layout=grid</div>",
      "<div x-articles layout=\"list\">layout=list</div>",
      "<div x-articles layout=\"masonry\">layout=masonry</div>",
      "<div x-articles pagination>with pagination</div>",
      "<div x-articles columns=\"3\">columns=3</div>",
      "<div x-articles limit=\"10\">limit=10</div>",
      "<div x-articles source=\"Sample source\">source=\"Sample source\"</div>",
      "<div x-articles layout=\"grid\"><div x-article title=\"1\"></div><div x-article title=\"2\"></div></div>"
    ],
    "matrix": {
      "combinations": [
        {
          "layout": "grid"
        },
        {
          "layout": "list"
        },
        {
          "layout": "grid",
          "columns": 2
        }
      ]
    },
    "site": {
      "page": "content",
      "tag": "x-articles",
      "renders": true,
      "baseClass": "x-articles",
      "minInstances": 3,
      "checkText": [],
      "checkClasses": [],
      "checkAttributes": [
        "layout"
      ]
    }
  },
  "_metadata": {
    "category": "layout",
    "icon": "📰",
    "related": [
      "article",
      "grid"
    ]
  },
  "$methods": {}
}

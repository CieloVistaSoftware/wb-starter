{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Card Profile",
  "description": "Simple profile card. Composes the shared card structure and adds profile elements (avatar, name, role, bio, cover).",
  "schemaFor": "cardprofile",
  "baseClass": "x-card",
  "properties": {
    "name": {
      "type": "string",
      "description": "Person's name",
      "required": true,
      "default": "John Doe"
    },
    "role": {
      "type": "string",
      "description": "Job title or role",
      "default": "Designer"
    },
    "avatar": {
      "type": "string",
      "description": "Avatar image URL",
      "default": ""
    },
    "bio": {
      "type": "string",
      "description": "Short biography",
      "inputType": "textarea",
      "default": "this is the bio"
    },
    "cover": {
      "type": "string",
      "description": "Cover/banner image URL",
      "default": "this is the cover"
    },
    "size": {
      "type": "string",
      "description": "Avatar size",
      "enum": [
        "sm",
        "md",
        "lg"
      ],
      "default": "md",
      "inputType": "select"
    },
    "align": {
      "type": "string",
      "description": "Content alignment",
      "enum": [
        "left",
        "center"
      ],
      "default": "center",
      "inputType": "select"
    },
    "hoverText": {
      "type": "string",
      "description": "Alias for `tooltip` -- hover text shown as a themed WB tooltip (x-tooltip / tooltip.js), not the native browser title tooltip (#283).",
      "default": "this is the hover text",
      "appliesAttribute": "x-tooltip"
    }
  },
  "$view": [
    {
      "name": "cover",
      "tag": "figure",
      "class": "x-card__profile-cover",
      "createdWhen": "cover",
      "children": [
        {
          "name": "cover-img",
          "tag": "img",
          "src": "{{cover}}",
          "alt": ""
        }
      ]
    },
    {
      "name": "avatar",
      "tag": "figure",
      "class": "x-card__profile-avatar"
    },
    {
      "name": "avatar-img",
      "tag": "img",
      "parent": "avatar",
      "src": "{{avatar}}",
      "alt": "Profile photo of {{name}}"
    },
    {
      "name": "header",
      "tag": "header",
      "required": true
    },
    {
      "name": "name",
      "tag": "h3",
      "parent": "header",
      "class": "x-card__profile-name",
      "content": "{{name}}",
      "required": true
    },
    {
      "name": "role",
      "tag": "p",
      "parent": "header",
      "class": "x-card__profile-role",
      "content": "{{role}}",
      "createdWhen": "role"
    },
    {
      "name": "bio",
      "tag": "p",
      "class": "x-card__profile-bio",
      "content": "{{bio}}",
      "createdWhen": "bio"
    }
  ],
  "$methods": {
    "show": {
      "description": "Shows the card",
      "params": []
    },
    "hide": {
      "description": "Hides the card",
      "params": []
    },
    "update": {
      "description": "Updates profile properties",
      "params": [
        "options"
      ]
    }
  },
  "compliance": {
    "baseClass": "x-card"
  },
  "accessibility": {
    "avatar": {
      "alt": "Profile photo of {name}"
    }
  },
  "$cssAPI": {
    "--bg-secondary": {
      "description": "Avatar border color",
      "default": "inherit"
    },
    "--primary": {
      "description": "Role text color",
      "default": "inherit"
    },
    "--text-secondary": {
      "description": "Bio text color",
      "default": "inherit"
    }
  },
  "test": {
    "setup": [
      "<div x-cardprofile>Basic cardprofile content</div>",
      "<div x-cardprofile size=\"sm\">size=sm</div>",
      "<div x-cardprofile size=\"md\">size=md</div>",
      "<div x-cardprofile size=\"lg\">size=lg</div>",
      "<div x-cardprofile align=\"left\">align=left</div>",
      "<div x-cardprofile align=\"center\">align=center</div>",
      "<div x-cardprofile name=\"John Doe\">name=\"John Doe\"</div>",
      "<div x-cardprofile role=\"Designer\">role=\"Designer\"</div>",
      "<div x-cardprofile name=\"Jane\" role=\"Designer\" avatar=\"https://upload.wikimedia.org/wikipedia/commons/thumb/9/9d/A_headshot_of_a_woman_with_a_high_chignon_-_DPLA_-_b55eef9ae85258f9b52cf39f5b6a759b_%28page_1%29.jpg/330px-A_headshot_of_a_woman_with_a_high_chignon_-_DPLA_-_b55eef9ae85258f9b52cf39f5b6a759b_%28page_1%29.jpg\"></div>"
    ],
    "matrix": {
      "combinations": [
        {
          "name": "John Doe"
        },
        {
          "name": "John Doe",
          "role": "Developer"
        },
        {
          "name": "John Doe",
          "avatar": "https://upload.wikimedia.org/wikipedia/commons/thumb/4/48/Outdoors-man-portrait_%28cropped%29.jpg/330px-Outdoors-man-portrait_%28cropped%29.jpg"
        },
        {
          "name": "John Doe",
          "bio": "Short bio."
        },
        {
          "name": "John Doe",
          "cover": "https://upload.wikimedia.org/wikipedia/commons/thumb/b/b5/Tarfala_valley_panorama.jpg/1280px-Tarfala_valley_panorama.jpg"
        },
        {
          "name": "John Doe",
          "size": "sm"
        },
        {
          "name": "John Doe",
          "size": "lg"
        },
        {
          "name": "John Doe",
          "align": "left"
        },
        {
          "name": "Full",
          "role": "CEO",
          "avatar": "https://upload.wikimedia.org/wikipedia/commons/thumb/7/7e/A_headshot_of_a_young_man_with_combed_back_hair_-_DPLA_-_8fdffabe9cf50ff6c9e74d9912e0c175_%28page_2%29.jpg/330px-A_headshot_of_a_young_man_with_combed_back_hair_-_DPLA_-_8fdffabe9cf50ff6c9e74d9912e0c175_%28page_2%29.jpg",
          "bio": "Leader.",
          "cover": "https://upload.wikimedia.org/wikipedia/commons/thumb/e/e0/Lavender_field_on_Hvar.JPG/1280px-Lavender_field_on_Hvar.JPG",
          "size": "lg",
          "align": "center"
        }
      ]
    },
    "site": {
      "page": "cards",
      "tag": "x-cardprofile",
      "renders": true,
      "minInstances": 9,
      "checkText": [
        "John Doe",
        "Short bio."
      ],
      "checkClasses": [],
      "checkAttributes": [
        "name"
      ]
    }
  },
  "builder": {
    "category": "Cards",
    "icon": "👨",
    "name": "Card Profile",
    "description": "Simple profile card with avatar",
    "defaults": {
      "name": "John Doe",
      "role": "Designer",
      "avatar": "https://upload.wikimedia.org/wikipedia/commons/thumb/4/48/Outdoors-man-portrait_%28cropped%29.jpg/330px-Outdoors-man-portrait_%28cropped%29.jpg",
      "bio": "",
      "cover": "",
      "size": "md",
      "align": "center"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cardhero.schema.json",
  "title": "Hero Card",
  "description": "Hero banner with background image, title, subtitle, and optional CTA",
  "schemaFor": "cardhero",
  "baseClass": "x-hero",
  "semanticElement": {
    "tagName": "section",
    "implicitRole": "banner"
  },
  "compliance": {
    "baseClass": "x-hero",
    "supportLevel": "stable",
    "accessibility": "high"
  },
  "properties": {
    "background": {
      "type": "string",
      "description": "Background image URL",
      "required": true,
      "default": ""
    },
    "title": {
      "type": "string",
      "description": "Hero headline",
      "required": true,
      "default": ""
    },
    "pretitle": {
      "type": "string",
      "description": "Small label or count shown above the title (e.g. '100 Components')",
      "default": ""
    },
    "subtitle": {
      "type": "string",
      "description": "Hero tagline/subheadline",
      "default": ""
    },
    "content": {
      "type": "string",
      "description": "HTML content rendered in the hero content area (allows attribute-only usage instead of slots)",
      "default": ""
    },
    "cta": {
      "type": "string",
      "description": "Call-to-action button text",
      "default": ""
    },
    "ctaHref": {
      "type": "string",
      "description": "Call-to-action link URL",
      "default": "#"
    },
    "ctaSecondary": {
      "type": "string",
      "description": "Secondary CTA text",
      "default": ""
    },
    "ctaSecondaryHref": {
      "type": "string",
      "description": "Secondary CTA URL",
      "default": "#"
    },
    "variant": {
      "type": "string",
      "description": "Visual style variant",
      "enum": [
        "default",
        "cosmic",
        "split",
        "minimal",
        "gradient"
      ],
      "default": "default",
      "appliesClass": "x-hero--{{value}}"
    },
    "xalign": {
      "type": "string",
      "description": "Horizontal content alignment (x-axis)",
      "enum": [
        "left",
        "center",
        "right"
      ],
      "default": "center",
      "appliesClass": "x-hero--xalign-{{value}}"
    },
    "overlay": {
      "type": "boolean",
      "description": "Show gradient overlay for text readability",
      "default": true,
      "appliesClass": "x-hero--overlay"
    },
    "fullHeight": {
      "type": "boolean",
      "description": "Make hero full viewport height",
      "default": false,
      "appliesClass": "x-hero--full"
    }
  },
  "$view": [
    {
      "name": "background",
      "tag": "div",
      "public": false,
      "required": true,
      "description": "Background image container"
    },
    {
      "name": "overlay",
      "tag": "div",
      "parent": "background",
      "public": false,
      "createdWhen": "overlay",
      "description": "Gradient overlay for text readability"
    },
    {
      "name": "content",
      "tag": "div",
      "public": true,
      "required": true,
      "description": "Content container for title, subtitle, CTA"
    },
    {
      "name": "pretitle",
      "tag": "div",
      "parent": "content",
      "public": true,
      "content": "{{pretitle}}",
      "createdWhen": "pretitle",
      "description": "Content above title"
    },
    {
      "name": "title",
      "tag": "h1",
      "parent": "content",
      "public": true,
      "content": "{{title}}",
      "createdWhen": "title",
      "description": "Hero headline"
    },
    {
      "name": "subtitle",
      "tag": "p",
      "parent": "content",
      "public": true,
      "content": "{{subtitle}}",
      "createdWhen": "subtitle",
      "description": "Hero tagline"
    },
    {
      "name": "cta",
      "tag": "a",
      "parent": "content",
      "public": true,
      "content": "{{cta}}",
      "createdWhen": "cta",
      "attributes": {
        "href": "{{ctaHref}}"
      },
      "description": "Call-to-action button"
    },
    {
      "name": "ctaSecondary",
      "tag": "a",
      "parent": "content",
      "public": true,
      "content": "{{ctaSecondary}}",
      "createdWhen": "ctaSecondary",
      "attributes": {
        "href": "{{ctaSecondaryHref}}"
      },
      "description": "Secondary call-to-action button (was previously missing entirely -- ctaSecondary/ctaSecondaryHref properties existed but nothing rendered them)"
    }
  ],
  "$methods": {
    "show": {
      "description": "Shows the hero",
      "params": []
    },
    "hide": {
      "description": "Hides the hero",
      "params": []
    },
    "toggle": {
      "description": "Toggles hero visibility",
      "params": []
    },
    "animate": {
      "description": "Triggers hero entrance animation",
      "params": [
        "animationType"
      ],
      "returns": "Promise"
    },
    "setBackground": {
      "description": "Changes the background image",
      "params": [
        "url"
      ]
    }
  },
  "$cssAPI": {
    "--x-hero-height": {
      "default": "400px",
      "description": "Hero height (ignored when fullHeight is true)"
    },
    "--x-hero-min-height": {
      "default": "300px",
      "description": "Minimum hero height"
    },
    "--x-hero-padding": {
      "default": "2rem",
      "description": "Content padding"
    },
    "--x-hero-gap": {
      "default": "1rem",
      "description": "Gap between title, subtitle, and CTA"
    },
    "--x-hero-title-size": {
      "default": "3rem",
      "description": "Title font size"
    },
    "--x-hero-title-weight": {
      "default": "700",
      "description": "Title font weight"
    },
    "--x-hero-subtitle-size": {
      "default": "1.25rem",
      "description": "Subtitle font size"
    },
    "--x-hero-text-color": {
      "default": "#ffffff",
      "description": "Text color"
    },
    "--x-hero-text-shadow": {
      "default": "0 2px 4px rgba(0,0,0,0.3)",
      "description": "Text shadow for readability"
    },
    "--x-hero-overlay-start": {
      "default": "rgba(0,0,0,0.1)",
      "description": "Overlay gradient start color"
    },
    "--x-hero-overlay-end": {
      "default": "rgba(0,0,0,0.6)",
      "description": "Overlay gradient end color"
    },
    "--x-hero-cta-bg": {
      "default": "var(--primary, #6366f1)",
      "description": "CTA button background"
    },
    "--x-hero-cta-color": {
      "default": "#ffffff",
      "description": "CTA button text color"
    },
    "--x-hero-cta-padding": {
      "default": "0.75rem 1.5rem",
      "description": "CTA button padding"
    },
    "--x-hero-cta-radius": {
      "default": "4px",
      "description": "CTA button border radius"
    }
  },
  "test": {
    "setup": [
      "<div x-cardhero>Basic cardhero content</div>",
      "<div x-cardhero variant=\"default\">variant=default</div>",
      "<div x-cardhero variant=\"cosmic\">variant=cosmic</div>",
      "<div x-cardhero variant=\"split\">variant=split</div>",
      "<div x-cardhero xalign=\"left\">xalign=left</div>",
      "<div x-cardhero xalign=\"center\">xalign=center</div>",
      "<div x-cardhero xalign=\"right\">xalign=right</div>",
      "<div x-cardhero overlay>with overlay</div>",
      "<div x-cardhero title=\"Test Title\">With title attribute</div>",
      "<div x-cardhero pretitle='100 Components' title='Build <span class=\"x-gradient-text\">stunning UIs</span>' subtitle='just HTML' cta='Explore Components'></div>",
      "<div x-cardhero background=\"/images/dachshund-puppy-image-960x540.jpg\" title=\"Welcome\"></div>",
      "<div x-cardhero background=\"/images/dachshund-puppy-image-960x540.jpg\" title=\"Explore\" subtitle=\"Your journey\" cta=\"Get Started\"></div>"
    ],
    "matrix": {
      "combinations": [
        {
          "background": "/images/dachshund-puppy-image-960x540.jpg",
          "title": "Welcome"
        },
        {
          "background": "/images/dachshund-puppy-image-960x540.jpg",
          "title": "Welcome",
          "subtitle": "Subtitle"
        },
        {
          "background": "/images/dachshund-puppy-image-960x540.jpg",
          "title": "Welcome",
          "cta": "Click Me"
        },
        {
          "background": "/images/dachshund-puppy-image-960x540.jpg",
          "title": "Welcome",
          "subtitle": "Sub",
          "cta": "Go",
          "variant": "cosmic"
        },
        {
          "background": "/images/dachshund-puppy-image-960x540.jpg",
          "title": "Welcome",
          "xalign": "left"
        },
        {
          "background": "/images/dachshund-puppy-image-960x540.jpg",
          "title": "Welcome",
          "overlay": false
        },
        {
          "background": "/images/dachshund-puppy-image-960x540.jpg",
          "title": "Welcome",
          "fullHeight": true
        }
      ]
    },
    "site": {
      "page": "cards",
      "tag": "x-cardhero",
      "renders": true,
      "baseClass": "x-hero",
      "minInstances": 7,
      "checkText": [
        "Welcome",
        "Subtitle",
        "Sub"
      ],
      "checkClasses": [
        "x-hero--cosmic",
        "x-hero--xalign-left"
      ],
      "checkAttributes": [
        "background",
        "title"
      ]
    }
  },
  "_metadata": {
    "category": "cards",
    "icon": "🦸",
    "since": "1.0.0",
    "status": "stable"
  }
}

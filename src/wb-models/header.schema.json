{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "header.schema.json",
  "title": "Header",
  "description": "Page header with logo, title, and optional navigation",
  "schemaFor": "header",
  "baseClass": "x-header",
  "semanticElement": {
    "tagName": "header",
    "implicitRole": "banner"
  },
  "compliance": {
    "baseClass": "x-header",
    "supportLevel": "stable",
    "accessibility": "high"
  },
  "properties": {
    "icon": {
      "type": "string",
      "description": "Logo icon (emoji or text)",
      "default": ""
    },
    "title": {
      "type": "string",
      "description": "Header title",
      "default": ""
    },
    "subtitle": {
      "type": "string",
      "description": "Subtitle text",
      "default": ""
    },
    "badge": {
      "type": "string",
      "description": "Badge text (e.g., version)",
      "default": ""
    },
    "logoHref": {
      "type": "string",
      "description": "Logo link URL",
      "default": "/"
    },
    "sticky": {
      "type": "boolean",
      "description": "Sticky at top",
      "default": false,
      "appliesClass": "x-header--sticky"
    }
  },
  "$view": [
    {
      "name": "left",
      "tag": "div",
      "public": true,
      "description": "Left section"
    },
    {
      "name": "logo",
      "tag": "a",
      "attributes": {
        "href": "{{logoHref}}"
      },
      "parent": "left",
      "public": true,
      "createdWhen": "icon OR title",
      "description": "Logo link"
    },
    {
      "name": "icon",
      "tag": "span",
      "parent": "logo",
      "public": true,
      "content": "{{icon}}",
      "createdWhen": "icon",
      "description": "Logo icon"
    },
    {
      "name": "title",
      "tag": "span",
      "parent": "logo",
      "public": true,
      "content": "{{title}}",
      "createdWhen": "title",
      "description": "Title"
    },
    {
      "name": "subtitle",
      "tag": "span",
      "parent": "left",
      "public": true,
      "content": "{{subtitle}}",
      "createdWhen": "subtitle",
      "description": "Subtitle"
    },
    {
      "name": "center",
      "tag": "div",
      "content": "{{center}}",
      "required": true,
      "public": true,
      "description": "Center section slot"
    },
    {
      "name": "right",
      "tag": "div",
      "content": "{{right}}",
      "required": true,
      "public": true,
      "description": "Right section"
    },
    {
      "name": "badge",
      "tag": "span",
      "class": "x-tag-glass",
      "parent": "right",
      "public": true,
      "content": "{{badge}}",
      "createdWhen": "badge",
      "description": "Badge"
    }
  ],
  "$methods": {
    "setTitle": {
      "description": "Updates title",
      "params": [
        "title"
      ]
    },
    "setIcon": {
      "description": "Updates icon",
      "params": [
        "icon"
      ]
    },
    "setBadge": {
      "description": "Updates badge",
      "params": [
        "badge"
      ]
    }
  },
  "$cssAPI": {
    "--x-header-height": {
      "default": "60px",
      "description": "Header height"
    },
    "--x-header-padding": {
      "default": "0 1rem",
      "description": "Padding"
    },
    "--x-header-bg": {
      "default": "var(--bg-surface, #ffffff)",
      "description": "Background"
    },
    "--x-header-border": {
      "default": "1px solid var(--border-color, #e0e0e0)",
      "description": "Border"
    },
    "--x-header-shadow": {
      "default": "none",
      "description": "Shadow"
    },
    "--x-header-title-size": {
      "default": "1.25rem",
      "description": "Title font size"
    },
    "--x-header-title-weight": {
      "default": "700",
      "description": "Title font weight"
    },
    "--x-header-icon-size": {
      "default": "1.5rem",
      "description": "Icon size"
    }
  },
  "accessibility": {
    "role": "banner"
  },
  "test": {
    "setup": [
      "<header>Basic header content</header>",
      "<header sticky>with sticky</header>",
      "<header icon=\"Sample icon\">icon=\"Sample icon\"</header>",
      "<header title=\"Sample title\">title=\"Sample title\"</header>",
      "<header subtitle=\"Sample subtitle\">subtitle=\"Sample subtitle\"</header>",
      "<header badge=\"Sample badge\">badge=\"Sample badge\"</header>",
      "<header logo-href=\"/\">logoHref=\"/\"</header>",
      "<header icon=\"📂\" title=\"Project\"></header>"
    ],
    "matrix": {
      "combinations": [
        {
          "title": "Title"
        },
        {
          "icon": "📂",
          "title": "Title"
        },
        {
          "icon": "🚀",
          "title": "App",
          "badge": "v1.0"
        },
        {
          "title": "Site",
          "sticky": true
        }
      ]
    },
    "site": {
      "page": "layout",
      "tag": "x-header",
      "renders": true,
      "baseClass": "x-header",
      "minInstances": 4,
      "checkText": [
        "Title",
        "App",
        "Site"
      ],
      "checkClasses": [],
      "checkAttributes": [
        "title"
      ]
    }
  },
  "_metadata": {
    "category": "layout",
    "icon": "📰",
    "since": "1.0.0",
    "status": "stable"
  }
}

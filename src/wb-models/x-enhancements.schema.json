{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "x-enhancements Attributes",
  "schemaType": "behavior",
  "type": "object",
  "description": "Schema for x-enhancements attributes (x-form, x-password, x-tags, x-file).",
  "properties": {
    "x-form": {
      "type": "boolean",
      "default": false
    },
    "x-password": {
      "type": "boolean",
      "default": false
    },
    "x-tags": {
      "type": "boolean",
      "default": false
    },
    "x-file": {
      "type": "boolean",
      "default": false
    }
  },
  "anyOf": [
    {
      "required": [
        "x-form"
      ]
    },
    {
      "required": [
        "x-password"
      ]
    },
    {
      "required": [
        "x-tags"
      ]
    },
    {
      "required": [
        "x-file"
      ]
    }
  ]
}

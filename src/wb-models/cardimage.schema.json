{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cardimage.schema.json",
  "title": "Image Card",
  "description": "Card with featured image and optional title/subtitle",
  "schemaFor": "cardimage",
  "baseClass": "x-card-image",
  "semanticElement": {
    "tagName": "article",
    "implicitRole": "article"
  },
  "compliance": {
    "baseClass": "x-card-image",
    "supportLevel": "stable",
    "accessibility": "high"
  },
  "properties": {
    "src": {
      "type": "string",
      "description": "Image source URL",
      "required": true,
      "default": "https://picsum.photos/seed/cardimage/600/400"
    },
    "alt": {
      "type": "string",
      "description": "Image alt text (accessibility)",
      "default": ""
    },
    "title": {
      "type": "string",
      "description": "Card title",
      "default": ""
    },
    "subtitle": {
      "type": "string",
      "description": "Card subtitle",
      "default": ""
    },
    "caption": {
      "type": "string",
      "description": "Image caption (displayed below image)",
      "default": ""
    },
    "href": {
      "type": "string",
      "description": "Link URL (makes card clickable)",
      "default": ""
    },
    "aspect": {
      "type": "string",
      "description": "Image aspect ratio",
      "enum": [
        "16/9",
        "4/3",
        "1/1",
        "3/2",
        "21/9",
        "auto"
      ],
      "default": "16/9"
    },
    "position": {
      "type": "string",
      "description": "Image position relative to content",
      "enum": [
        "top",
        "bottom",
        "left",
        "right"
      ],
      "default": "top",
      "appliesClass": "x-card-image--{{value}}"
    },
    "fit": {
      "type": "string",
      "description": "Image object-fit mode",
      "enum": [
        "cover",
        "contain",
        "fill",
        "none"
      ],
      "default": "cover"
    },
    "loading": {
      "type": "string",
      "description": "Image loading strategy",
      "enum": [
        "lazy",
        "eager"
      ],
      "default": "lazy"
    },
    "variant": {
      "type": "string",
      "description": "Visual style variant",
      "enum": [
        "default",
        "elevated",
        "bordered",
        "minimal"
      ],
      "default": "default",
      "appliesClass": "x-card-image--{{value}}"
    }
  },
  "$view": [
    {
      "name": "figure",
      "tag": "figure",
      "public": true,
      "required": true,
      "description": "Semantic figure containing image"
    },
    {
      "name": "image",
      "tag": "img",
      "parent": "figure",
      "public": true,
      "description": "The main image"
    },
    {
      "name": "caption",
      "tag": "figcaption",
      "parent": "figure",
      "public": true,
      "content": "{{caption}}",
      "createdWhen": "caption",
      "description": "Image caption"
    },
    {
      "name": "content",
      "tag": "div",
      "public": true,
      "createdWhen": "title OR subtitle OR body",
      "description": "Content area for title/subtitle"
    },
    {
      "name": "title",
      "tag": "h3",
      "parent": "content",
      "public": true,
      "content": "{{title}}",
      "createdWhen": "title",
      "description": "Card title"
    },
    {
      "name": "subtitle",
      "tag": "p",
      "parent": "content",
      "public": true,
      "content": "{{subtitle}}",
      "createdWhen": "subtitle",
      "description": "Card subtitle"
    },
    {
      "name": "body",
      "tag": "div",
      "parent": "content",
      "public": true,
      "content": "<slot></slot>",
      "createdWhen": "body",
      "description": "Additional content slot"
    }
  ],
  "$methods": {
    "show": {
      "description": "Shows the card",
      "params": []
    },
    "hide": {
      "description": "Hides the card",
      "params": []
    },
    "toggle": {
      "description": "Toggles visibility",
      "params": []
    },
    "setImage": {
      "description": "Changes the image source",
      "params": [
        "src",
        "alt"
      ]
    },
    "preload": {
      "description": "Preloads the image",
      "params": [],
      "returns": "Promise"
    }
  },
  "$cssAPI": {
    "--x-card-image-radius": {
      "default": "8px",
      "description": "Card border radius"
    },
    "--x-card-image-bg": {
      "default": "var(--bg-surface, #ffffff)",
      "description": "Card background"
    },
    "--x-card-image-border": {
      "default": "none",
      "description": "Card border"
    },
    "--x-card-image-shadow": {
      "default": "none",
      "description": "Card shadow"
    },
    "--x-card-image-img-radius": {
      "default": "8px 8px 0 0",
      "description": "Image border radius (top position)"
    },
    "--x-card-image-aspect": {
      "default": "16/9",
      "description": "Image aspect ratio"
    },
    "--x-card-image-content-padding": {
      "default": "1rem",
      "description": "Content area padding"
    },
    "--x-card-image-content-gap": {
      "default": "0.5rem",
      "description": "Gap between title and subtitle"
    },
    "--x-card-image-title-size": {
      "default": "1.125rem",
      "description": "Title font size"
    },
    "--x-card-image-title-weight": {
      "default": "600",
      "description": "Title font weight"
    },
    "--x-card-image-title-color": {
      "default": "var(--text-primary, #1a1a1a)",
      "description": "Title text color"
    },
    "--x-card-image-subtitle-size": {
      "default": "0.875rem",
      "description": "Subtitle font size"
    },
    "--x-card-image-subtitle-color": {
      "default": "var(--text-secondary, #666)",
      "description": "Subtitle text color"
    },
    "--x-card-image-caption-size": {
      "default": "0.75rem",
      "description": "Caption font size"
    },
    "--x-card-image-caption-color": {
      "default": "var(--text-tertiary, #999)",
      "description": "Caption text color"
    },
    "--x-card-image-hover-transform": {
      "default": "translateY(-2px)",
      "description": "Hover transform effect"
    },
    "--x-card-image-hover-shadow": {
      "default": "0 4px 12px rgba(0,0,0,0.15)",
      "description": "Hover shadow"
    }
  },
  "test": {
    "setup": [
      "<div x-cardimage>Basic cardimage content</div>",
      "<div x-cardimage aspect=\"16/9\">aspect=16/9</div>",
      "<div x-cardimage aspect=\"4/3\">aspect=4/3</div>",
      "<div x-cardimage aspect=\"1/1\">aspect=1/1</div>",
      "<div x-cardimage position=\"top\">position=top</div>",
      "<div x-cardimage position=\"bottom\">position=bottom</div>",
      "<div x-cardimage position=\"left\">position=left</div>",
      "<div x-cardimage fit=\"cover\">fit=cover</div>",
      "<div x-cardimage title=\"Test Title\">With title attribute</div>",
      "<div x-cardimage variant=\"default\">Variant: default</div>",
      "<div src=\"photo.jpg\" alt=\"Photo\"></div>",
      "<div src=\"photo.jpg\" title=\"Beautiful Scene\" subtitle=\"Nature photography\"></div>"
    ],
    "matrix": {
      "combinations": [
        {
          "src": "https://picsum.photos/seed/cardimage/600/400"
        },
        {
          "src": "https://picsum.photos/seed/cardimage/600/400",
          "alt": "Description"
        },
        {
          "src": "https://picsum.photos/seed/cardimage/600/400",
          "title": "Title"
        },
        {
          "src": "https://picsum.photos/seed/cardimage/600/400",
          "title": "Title",
          "subtitle": "Subtitle"
        },
        {
          "src": "https://picsum.photos/seed/cardimage/600/400",
          "caption": "Photo by John"
        },
        {
          "src": "https://picsum.photos/seed/cardimage/600/400",
          "aspect": "1/1"
        },
        {
          "src": "https://picsum.photos/seed/cardimage/600/400",
          "position": "bottom",
          "title": "Title"
        },
        {
          "src": "https://picsum.photos/seed/cardimage/600/400",
          "variant": "elevated"
        }
      ]
    },
    "site": {
      "page": "cards",
      "tag": "x-cardimage",
      "renders": true,
      "baseClass": "x-card-image",
      "minInstances": 8,
      "checkText": [
        "Title",
        "Subtitle"
      ],
      "checkClasses": [
        "x-card-image--bottom",
        "x-card-image--elevated"
      ],
      "checkAttributes": [
        "src"
      ]
    }
  },
  "_metadata": {
    "category": "cards",
    "icon": "🖼️",
    "since": "1.0.0",
    "status": "stable"
  }
}

# Dependencies
node_modules/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Test Results
data/test-results/
data/content-issues.json
# #562: runtime/test-run artifact written by src/core/error-logger.js +
# server.js's /api/error-log/* endpoints (and reset at the start of every
# `playwright test` invocation by scripts/tools/test-reporter.ts). Tracking
# it in git meant stale entries from unrelated past commits/sessions rode
# along into every fresh checkout and silently failed
# tests/compliance/error-log-empty.spec.ts for reasons no test in the CURRENT
# run caused -- same class of problem as data/content-issues.json above.
data/errors.json
.test-cache.json
.test-results-temp.json
# Playwright reports/screenshots — never track or deploy these to GitHub Pages
playwright-report/
playwright-screenshots/

# Archive (cleanup files)
archive/

*.zip

# Local test artifacts & scratch (ignore the entire tmp/ tree — Playwright/CI
# output, moved-html duplicates, triage scratch all live here and must not be tracked)
tmp/
test-results/
.playwright-artifacts/

# Extension signing key — never commit private keys
*.pem
*.crx
src/wb-overlay-ext/

# Agent worktrees (each is its own git repo) — never committed as gitlinks.
# A prior session accidentally `git add`ed one from the parent repo, which
# git recorded as a submodule reference (mode 160000) with no matching
# .gitmodules entry. GitHub's checkout action recursively inits submodules
# on every workflow run, including the Pages deploy -- with 30+ of these
# broken gitlinks accumulated in history, `pages-build-deployment` fatally
# errored on `git submodule update --init` on EVERY push since 2026-08-07,
# silently blocking every .io deployment. Ignoring the whole directory so
# this can't happen again.
.claude/worktrees/

# Archived runtime error logs (#1027). Local forensic copies of data/errors.json
# taken before a test run clears it — machine-specific, never worth committing.
data/error-log-archive/

# Playwright scratch output (#1038). Kept OUT of data/test-results/, which is
# the reporter evidence dir the issue-state engine reads — Playwright clears
# its outputDir on every run and was erasing that record.
data/playwright-output/

# Scratch file left by the issue tooling when composing an issue body.
.issue-body.tmp

# Issues list cache (#1045) — regenerated by GET /api/issues, machine-local.
data/issues-cache.json

# Traced-fixes cache (#1054) — regenerated by GET /api/fixes, machine-local and
# ~4MB. Keyed on HEAD, so it is worthless to anyone else's checkout anyway.
data/fixes-cache.json

# Per-run output of .husky/gate-staged-tree.mjs (#1065) - diagnostics, not source
data/gate-evidence/

# #1071: per-run machine output. These were TRACKED and rewritten by every test
# run and every commit, so the working tree could never be clean -- which made
# the version badge's "*" (uncommitted changes) permanent and meaningless, and
# buried real work among regenerated noise. Note data/test-results/ (the
# directory) was already ignored while data/test-results.json (the file) was
# not; that inconsistency was the bug in miniature.
data/test-results.json
data/test-status.json
data/bg-health.json
# #1081: the same defect, in the directory #1071 missed. scripts/test-async.mjs
# writes data/test-single/<spec>.json on every single-spec run, and 250 of them
# were TRACKED -- so the clean tree #1071 delivered lasted until the first time
# anyone verified anything.
#
# It stopped being cosmetic when #1076 made a push to main a release:
# scripts/ship.mjs refuses to release from a dirty tree, and release.mjs gate 1
# runs the suite, so the gate dirtied the tree the ship flow had just required
# be clean. Shipping was impossible until this line existed.
data/test-single/


#!/bin/sh
# WB Starter pre-commit hook — fast checks only.
#
# John, 2026-10-02: "no ci duplication at all" and "no full test run until the
# end of the day when i say park, then when I get up the next morning we have a
# new release".
#
# So this hook runs only checks that take seconds AND that CI does not run.
# Playwright runs nowhere here: PR CI runs every category (ci-tests.yml), and
# the full suite that decides a release runs nightly (nightly.yml). The old
# every-10th-commit full run and the per-commit priority-1 run are gone.

# #743: stamp, never bump -- a release cuts the version. stamp-version.js also
# moves index.html's ?v= cache keys, so both files are re-staged.
echo "🏷  Stamping version (no bump — a release cuts the version)..."
node scripts/stamp-version.js
git add src/core/version.js index.html

echo "🔍 Running pre-commit checks..."

# Lint ratchet on STAGED files (#840): fails only when a file you touched has
# more problems than its recorded baseline. CI does not lint.
node .husky/lint-ratchet.mjs --staged || exit 1

# A spec that collects zero tests exits 0 and reports success (#1091). Listing
# only: no browser, no server, a few seconds.
node scripts/check-spec-collection.mjs || exit 1

# The known-failures register only shrinks. Milliseconds, git only.
node scripts/check-register-shrinks.mjs || exit 1

# A control byte in staged source (#1162). Reads the index, milliseconds.
node scripts/check-staged-control-bytes.mjs || exit 1

echo ""
echo "✅ Pre-commit checks passed"
echo ""

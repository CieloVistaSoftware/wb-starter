#!/bin/sh
# WB Starter Pre-commit Hook
# Runs project-integrity tests before allowing commit

# #743: the `npm version patch` that used to run here is GONE.
#
# It bumped on EVERY commit, which drove 3.0.36 -> 3.0.60 in two days with
# nothing describing any of them, and stopped a release number identifying a
# build at all: 3.0.55 named two different commits, 3.0.35 named forty, and
# 3.0.56/58/59/60 never reached main. Worse, it turned this hook into
# something to get around — 16 commits in one day used --no-verify purely to
# dodge the bump, and every one of those skipped the checks below with it.
# A hook people must bypass is not a gate.
#
# The version moves only when a release is cut, deliberately, with a What's
# New entry naming it. Cache-busting keys off the version now, so it no longer
# needs a per-commit token.

echo "🏷  Stamping version (no bump — a release cuts the version)..."
node scripts/stamp-version.js
# stamp-version.js also bumps every ?v= cache-busting query string in
# index.html/project-index.html to match — only version.js was ever
# re-staged, leaving those two perpetually one commit stale (each commit's
# stamp reflected the PARENT commit's hash, since HEAD hasn't moved yet
# when this hook runs, and the cache-bust for THIS commit's own changes
# never got included in it).
git add src/core/version.js index.html project-index.html

echo "🔍 Running pre-commit checks..."

# ── Lint ratchet — EVERY commit (#840) ───────────────────────────────────────
# `npm run lint` has existed for a long time and this hook never called it. That
# is how 149 unawaited `WB.scan()` calls accumulated against 66 correct ones:
# nothing was looking. Playwright hands .ts to Babel, which strips types and
# runs — transpiling is not type-checking — and jsconfig.json only ever included
# **/*.js, so the .spec.ts suite sat outside every check the project had.
#
# This runs on EVERY commit, deliberately NOT inside the 10-commit block below.
# A check that runs one commit in ten lets nine commits of breakage through and
# then blames the tenth author for all of it. It lints only STAGED files, which
# keeps it to ~20-35s instead of the ~37s full-repo sweep.
#
# It is a RATCHET, not a pass/fail gate: it fails only when a file you touched
# has MORE problems than the baseline recorded for it — never merely because
# problems exist. Full rationale in .husky/lint-ratchet.mjs. Short version: a
# gate too strict to pass gets bypassed, and the --no-verify habit takes every
# other check down with it. This repo has already lived that once — see the #743
# note above, where 16 commits in one day used --no-verify to dodge the version
# bump and skipped all of these checks in the process.
node .husky/lint-ratchet.mjs --staged || exit 1

# ── Full validation every 10th commit ────────────────────────────────────────
# John: "after 10 fixes run the whole set of tests."
#
# Running the ~1hr matrix on every commit is a gate people disable; running it
# never is how sticky.spec.ts sat failing since January while 20 releases
# shipped over a red build. Ten is the compromise: fast checks every time, the
# whole suite often enough that a regression cannot travel far.
#
# The counter lives in .git/ deliberately — a tracked file would change on
# every commit, churn every diff, and conflict on every merge.
#
# #974: --git-common-dir, NOT --git-dir. In a worktree --git-dir resolves to
# .git/worktrees/<name>, so every worktree got its OWN counter starting at zero
# and the 10th-commit gate effectively never fired for agents — who work almost
# exclusively in worktrees. Observed: main sat at 9 while a fresh worktree sat
# at 1 and five agent worktrees had no counter at all, so the main checkout was
# absorbing the entire cadence alone. --git-common-dir returns .git from every
# worktree AND from the main checkout, making the count global, which is the
# only way "every 10th commit" means anything.
COUNT_FILE="$(git rev-parse --git-common-dir)/wb-fix-count"
COUNT=$(cat "$COUNT_FILE" 2>/dev/null || echo 0)
COUNT=$((COUNT + 1))

if [ "$COUNT" -ge 10 ]; then
  echo ""
  echo "🔁 $COUNT commits since the last full run — running the WHOLE suite"
  echo "   (compliance + regression + behaviors)"
  echo ""
  # #959: this used to exit 1 if ANY project was red. The suite has been red for
  # months (499 failures over 227 files), so that gate blocked every commit
  # permanently AND detected nothing -- a regression introduced today arrived as
  # one more line among 499, indistinguishable from January's debt. Blocked and
  # blind is worse than unblocked with real detection.
  #
  # It is a RATCHET now, on exactly the argument .husky/lint-ratchet.mjs (#840)
  # already makes for lint: fail only on failures NOT in the recorded baseline,
  # and drop repaired tests from that baseline so they can never rot again.
  # The register is data/test-baseline-failures.json; it only ever shrinks.
  node .husky/test-ratchet.mjs || exit 1

  echo ""
  # #959: NOT "green" -- the ratchet asserts "no NEW failures", which is a
  # weaker and more honest claim. Saying green here while 499 tests are red is
  # how a gate stops meaning anything.
  echo "✅ No new failures vs the baseline — counter reset."
  echo 0 > "$COUNT_FILE"
else
  echo "   ($COUNT/10 commits since the last full run)"
  echo "$COUNT" > "$COUNT_FILE"
fi


# Run project integrity tests only — NOT `npm test` (the full multi-tier
# matrix: compliance/regression/integration/base/behaviors, ~1hr). `npm test
# -- --grep ...` only appends those flags to the LAST command in that
# &&-chained script, so every commit was silently running the ENTIRE suite
# unfiltered before this fix (never caught: core.hooksPath wasn't set for
# this worktree until now, so the hook itself had never actually run).
npx playwright test tests/compliance/project-integrity.spec.ts --reporter=line

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Pre-commit checks FAILED"
  echo "   Fix the issues above before committing."
  echo ""
  exit 1
fi

echo ""
echo "✅ Pre-commit checks passed"
echo ""
